# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-breeze-icons); check-recipes.py keeps them the same.
pkgname=breeze-icons
_lockname=kf6-breeze-icons
pkgver=6.18.0
pkgrel=2
pkgdesc="Breeze, KDE's icons"
arch=(any)
url="https://kde.org/"
license=(LGPL-3.0-or-later)
depends=()
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/breeze-icons-$pkgver.tar.xz")
sha256sums=('4796c4ee6059a777ad8d954a4584e81fdf5047a94a7988fc374052c427bc0b60')

build() {
    cmake -S breeze-icons-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib -DWITH_ICON_GENERATION=OFF -DBINARY_ICONS_RESOURCE=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
