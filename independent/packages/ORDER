# The order Yūrei's packages are built in: each after what it needs to build.
# First batch: enough for a system installed by pacman to run a shell.
yurei-filesystem
linux-api-headers
glibc
zlib
bzip2
xz
lz4
zstd
ncurses
readline
bash
# Second batch: the toolchain, so the new system can build software itself.
binutils
gmp
mpfr
mpc
libxcrypt
gcc
