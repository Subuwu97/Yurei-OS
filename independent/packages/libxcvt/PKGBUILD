# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libxcvt
pkgver=0.1.2
pkgrel=1
pkgdesc="VESA CVT display mode timings, for Xwayland"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(glibc)
source=("https://www.x.org/releases/individual/lib/libxcvt-$pkgver.tar.xz")
sha256sums=('PIN')

build() {
    meson setup libxcvt-$pkgver build --prefix=/usr --buildtype=release
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
