# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=knewstuff
_lockname=kf6-knewstuff
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE theme and content downloads"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base qt6-declarative karchive kconfig kcoreaddons ki18n kpackage kwidgetsaddons attica kirigami)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/knewstuff-$pkgver.tar.xz")
sha256sums=('7e721735abf7e2f6f8c0f42324f885bcad1114c317ac79bfabc705fb8018dba5')

build() {
    cmake -S knewstuff-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a knewstuff-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
