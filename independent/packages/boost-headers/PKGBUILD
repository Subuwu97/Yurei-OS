# Maintainer: Yurei Linux project
# Upstream publishes the archive checksum alongside the release archive.
pkgname=boost-headers
pkgver=1.88.0
pkgrel=1
pkgdesc="Boost C++ headers for KDE and Plasma"
arch=(any)
url="https://www.boost.org/"
license=(BSL-1.0)
source=("https://archives.boost.io/release/1.88.0/source/boost_1_88_0.tar.bz2")
sha256sums=('46d9d2c06637b219270877c9e16155cbd015b6dc84349af064c088e9b5b12f7b')

package() {
    install -d "$pkgdir/usr/include"
    cp -a boost_1_88_0/boost "$pkgdir/usr/include/"
    install -Dm644 boost_1_88_0/LICENSE_1_0.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE_1_0.txt"
}
