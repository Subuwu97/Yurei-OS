# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=linux
pkgver=6.18
pkgrel=8
# NVIDIA's open kernel modules (MIT/GPL), built here against this kernel so
# their versions always match; nvidia-utils brings the matching driver
_nvidia=595.112.07
pkgdesc="Yūrei's Linux kernel and modules"
arch=(x86_64)
url="https://www.kernel.org/"
license=(GPL-2.0-only)
depends=(kmod)
# NVIDIA invokes ld directly; makepkg's compiler-driver LDFLAGS (-Wl,...)
# are invalid there. Use the kernel and NVIDIA build systems' own flags.
options=(!strip !buildflags)
source=("https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$pkgver.tar.xz"
        "open-gpu-kernel-modules-$_nvidia.tar.gz::https://github.com/NVIDIA/open-gpu-kernel-modules/archive/$_nvidia.tar.gz")
sha256sums=('9106a4605da9e31ff17659d958782b815f9591ab308d03b0ee21aad6c7dced4b'
            '6bf8f19b9d7fa6ca0029100fe09f8a72d413df67e08ad4428b1b358ec10d28c0')

build() {
    cd linux-$pkgver
    make mrproper
    # The kernel's own x86-64 defaults, what virtual machines need, what
    # systemd needs, and what real PCs and a live ISO need (iwd, the Wi-Fi
    # daemon, does its key exchange with the kernel's crypto, listed too). Disks, USB,
    # file systems and the boot display are built in, so the kernel
    # starts from any of them without modules; graphics, network and
    # sound drivers are modules, loaded for the hardware found. Graphics:
    # Intel (i915; xe for Arc B-series and newer), AMD (amdgpu; radeon for
    # older cards), NVIDIA (nouveau, and NVIDIA's own modules below) and
    # virtual machines. Laptops: I2C touchpads, Intel's SOF sound, battery,
    # backlight and the makers' hotkey drivers. Games: Xbox, PlayStation,
    # Nintendo and Steam controllers, uinput.
    make defconfig
    make kvm_guest.config
    scripts/config \
        -e DEVTMPFS -e DEVTMPFS_MOUNT -e CGROUPS -e MEMCG -e FHANDLE -e AUTOFS_FS \
        -e TMPFS_POSIX_ACL -e TMPFS_XATTR -e SECCOMP -e SECCOMP_FILTER -e NAMESPACES -e USER_NS -e PID_NS -e NET_NS -e IPC_NS -e UTS_NS -e BPF_SYSCALL -e CGROUP_BPF -e PSI \
        -e DMIID -e INOTIFY_USER -d UEVENT_HELPER -d SYSFS_DEPRECATED \
        -e EFI -e EFI_STUB -e EFIVAR_FS -e EFI_PARTITION \
        -e BLK_DEV_NVME -e ATA -e SATA_AHCI -e BLK_DEV_LOOP -e BLK_DEV_SD -e BLK_DEV_SR \
        -e MMC -e MMC_BLOCK -e MMC_SDHCI -e MMC_SDHCI_PCI \
        -e USB_SUPPORT -e USB_XHCI_HCD -e USB_EHCI_HCD -e USB_OHCI_HCD -e USB_STORAGE -e USB_UAS \
        -e HID -e HID_GENERIC -e USB_HID -e INPUT_EVDEV \
        -e EXT4_FS -e VFAT_FS -e FAT_FS -e NLS_CODEPAGE_437 -e NLS_ISO8859_1 -e NLS_UTF8 \
        -e EXFAT_FS -e NTFS3_FS -e ISO9660_FS -e JOLIET -e ZISOFS -e SQUASHFS -e SQUASHFS_XZ -e SQUASHFS_ZSTD \
        -e OVERLAY_FS -e TMPFS -e CDROM -e RD_GZIP -e RD_ZSTD \
        -e DRM -e DRM_SIMPLEDRM -e SYSFB_SIMPLEFB -e DRM_FBDEV_EMULATION -e FRAMEBUFFER_CONSOLE \
        -m DRM_I915 -m DRM_XE -m DRM_AMDGPU -e DRM_AMD_DC -e DRM_AMDGPU_USERPTR -m DRM_RADEON \
        -m DRM_NOUVEAU -m DRM_VIRTIO_GPU \
        -m E1000E -m IGB -m R8169 -m CFG80211 -m MAC80211 -m IWLWIFI -m IWLMVM \
        -m RTW88 -m RTW88_8822CE -m RTW88_8821CE -m RTW89 -m RTW89_8852AE -m RTW89_8852BE \
        -m MT7921E -m ATH10K -m ATH10K_PCI -m ATH11K -m ATH11K_PCI -m BRCMFMAC -e RFKILL \
        -e USB_NET_DRIVERS -m USB_USBNET -m USB_RTL8152 -m USB_NET_CDCETHER -m USB_NET_CDC_NCM \
        -m USB_NET_AX8817X -m USB_NET_AX88179_178A \
        -e FW_LOADER_COMPRESS -e FW_LOADER_COMPRESS_ZSTD -e FW_LOADER_COMPRESS_XZ \
        -e CRYPTO_USER_API_HASH -e CRYPTO_USER_API_SKCIPHER -e KEY_DH_OPERATIONS \
        -e CRYPTO_HMAC -e CRYPTO_CMAC -e CRYPTO_MD4 -e CRYPTO_MD5 -e CRYPTO_SHA1 -e CRYPTO_SHA256 \
        -e CRYPTO_SHA512 -e CRYPTO_AES -e CRYPTO_ECB -e CRYPTO_CBC -e CRYPTO_DES \
        -e ASYMMETRIC_KEY_TYPE -e ASYMMETRIC_PUBLIC_KEY_SUBTYPE -e X509_CERTIFICATE_PARSER \
        -e PKCS7_MESSAGE_PARSER -e PKCS8_PRIVATE_KEY_PARSER \
        -m SND_HDA_INTEL -m SND_HDA_CODEC_REALTEK -m SND_HDA_CODEC_HDMI \
        -e VIRTIO_BLK -e VIRTIO_NET -e SERIAL_8250_CONSOLE \
        -e HYPERVISOR_GUEST -e HYPERV -e HYPERV_VMBUS -e SCSI -e HYPERV_STORAGE \
        -e HYPERV_NET -e CONNECTOR -e PTP_1588_CLOCK -e HYPERV_UTILS -e HYPERV_BALLOON \
        -e HYPERV_KEYBOARD -e HID_HYPERV_MOUSE -e DRM_HYPERV -d FB_HYPERV \
        -m I2C_HID_ACPI -m I2C_DESIGNWARE_PLATFORM -m I2C_DESIGNWARE_PCI -m MFD_INTEL_LPSS_ACPI \
        -m MFD_INTEL_LPSS_PCI -e PINCTRL_INTEL -m PINCTRL_CANNONLAKE -m PINCTRL_TIGERLAKE \
        -m PINCTRL_ALDERLAKE -m PINCTRL_METEORLAKE -m HID_MULTITOUCH -m MOUSE_ELAN_I2C \
        -e MOUSE_ELAN_I2C_I2C -m MOUSE_SYNAPTICS_I2C \
        -m SND_SOC -e SND_SOC_SOF_TOPLEVEL -m SND_SOC_SOF_PCI -e SND_SOC_SOF_INTEL_TOPLEVEL \
        -m SND_SOC_SOF_TIGERLAKE -m SND_SOC_SOF_ALDERLAKE -m SND_SOC_SOF_METEORLAKE \
        -m SND_SOC_SOF_LUNARLAKE -e SND_SOC_SOF_HDA_LINK -e SND_SOC_SOF_HDA_AUDIO_CODEC \
        -e SND_SOC_INTEL_MACH -m SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH \
        -m SND_SOC_INTEL_SOF_RT5682_MACH -m SND_SOC_INTEL_SOF_SSP_AMP_MACH -m SND_SOC_DMIC \
        -e SPI -e SPI_MASTER -e I2C -m SOUNDWIRE -m SOUNDWIRE_INTEL \
        -e SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES -m SND_SOC_SOF_INTEL_SOUNDWIRE \
        -m SND_SOC_INTEL_SOUNDWIRE_SOF_MACH -m SND_HDA_GENERIC \
        -m SND_HDA_CODEC_CONEXANT -m SND_USB_AUDIO -m SND_SOC_AMD_ACP6x -m SND_SOC_AMD_PS \
        -e INPUT_JOYSTICK -m INPUT_JOYDEV -m JOYSTICK_XPAD -e JOYSTICK_XPAD_FF -m HID_SONY \
        -e SONY_FF -m HID_PLAYSTATION -e PLAYSTATION_FF -m HID_NINTENDO -m HID_STEAM \
        -m HID_MICROSOFT -e HID_BATTERY_STRENGTH -m INPUT_UINPUT \
        -e ACPI_BATTERY -e ACPI_AC -m ACPI_VIDEO -e X86_PLATFORM_DEVICES -m DELL_LAPTOP \
        -m DELL_WMI -m INTEL_HID_EVENT -m INTEL_VBTN -m THINKPAD_ACPI -m IDEAPAD_LAPTOP \
        -m ASUS_NB_WMI -m HP_WMI \
        -e MEDIA_SUPPORT -e MEDIA_USB_SUPPORT -e MEDIA_CAMERA_SUPPORT -m USB_VIDEO_CLASS \
        --set-str LOCALVERSION -yurei -d LOCALVERSION_AUTO
    make olddefconfig
    # The live initramfs cannot load modules; the Hyper-V bus and DVD/disk
    # drivers must work before the squashfs can be located.
    for option in HYPERV HYPERV_VMBUS HYPERV_STORAGE SCSI BLK_DEV_SD BLK_DEV_SR HYPERV_NET DRM_HYPERV HYPERV_KEYBOARD HID_HYPERV_MOUSE; do
        grep -qx "CONFIG_${option}=y" .config || { echo "Missing built-in $option" >&2; return 1; }
    done
    for option in SOUNDWIRE SOUNDWIRE_INTEL SND_SOC_SOF_INTEL_SOUNDWIRE SND_SOC_INTEL_SOUNDWIRE_SOF_MACH SND_SOC_RT711_SDCA_SDW SND_SOC_RT1316_SDW; do
        grep -Eq "^CONFIG_${option}=[ym]$" .config || { echo "Missing laptop audio driver $option" >&2; return 1; }
    done
    make
    make -C "$srcdir/open-gpu-kernel-modules-$_nvidia" modules SYSSRC="$PWD" SYSOUT="$PWD"
}

package() {
    cd linux-$pkgver
    local release
    release=$(make -s kernelrelease)
    make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/bin/true modules_install
    rm -f "$pkgdir/usr/lib/modules/$release/build"
    install -Dm644 arch/x86/boot/bzImage "$pkgdir/boot/vmlinuz-yurei"
    install -Dm644 arch/x86/boot/bzImage "$pkgdir/usr/lib/modules/$release/vmlinuz"
    install -Dm644 .config "$pkgdir/usr/lib/modules/$release/config"
    local ko
    for ko in "$srcdir/open-gpu-kernel-modules-$_nvidia"/kernel-open/*.ko; do
        install -Dm644 "$ko" "$pkgdir/usr/lib/modules/$release/kernel/drivers/video/nvidia/${ko##*/}"
        strip --strip-debug "$pkgdir/usr/lib/modules/$release/kernel/drivers/video/nvidia/${ko##*/}"
    done
    # the module index, made now rather than when installing
    depmod -b "$pkgdir/usr" "$release"
}
