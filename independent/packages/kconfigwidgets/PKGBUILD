# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kconfigwidgets
_lockname=kf6-kconfigwidgets
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kconfigwidgets"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base kcoreaddons kcodecs kconfig kguiaddons ki18n kwidgetsaddons kcolorscheme)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kconfigwidgets-$pkgver.tar.xz")
sha256sums=('aa5a7be6278a19733f77e6a435f84c3e71926b28f1ac3766313778890d640813')

build() {
    cmake -S kconfigwidgets-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kconfigwidgets-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
