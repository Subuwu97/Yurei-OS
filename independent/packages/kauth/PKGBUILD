# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kauth
_lockname=kf6-kauth
pkgver=6.18.0
pkgrel=1
pkgdesc="Desktop authorization framework"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 LGPL-2.0-or-later LGPL-2.1-or-later)
depends=(qt6-base kcoreaddons kwindowsystem polkit-qt6)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kauth-$pkgver.tar.xz")
sha256sums=('8c6fee69482e7a3dfcf7eacca9cb6a191ec5d1b09e0a539e1f7d5d76d08403e9')

build() {
    cmake -S kauth-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DKAUTH_BACKEND_NAME=PolkitQt6-1 -DCMAKE_REQUIRE_FIND_PACKAGE_PolkitQt6-1=ON -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kauth-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
