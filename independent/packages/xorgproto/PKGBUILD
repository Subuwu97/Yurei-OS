# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=xorgproto
pkgver=2024.1
pkgrel=1
pkgdesc="X11 protocol headers"
arch=(any)
url="https://www.x.org/"
license=(MIT)
source=("https://www.x.org/releases/individual/proto/xorgproto-$pkgver.tar.xz")
sha256sums=('372225fd40815b8423547f5d890c5debc72e88b91088fbfb13158c20495ccb59')

build() {
    cd xorgproto-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
        --disable-specs
    make
}

package() {
    cd xorgproto-$pkgver
    make DESTDIR="$pkgdir" install
}
