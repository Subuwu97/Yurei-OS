# Maintainer: Yurei Linux project
pkgname=plasma-desktop
_lockname=plasma-plasma-desktop
pkgver=6.4.5
pkgrel=2
pkgdesc="Plasma desktop panels and configuration modules"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 GFDL-1.2-or-later GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only Unicode-DFS-2016)
depends=(qt6-base qt6-declarative qt6-wayland qt6-5compat qt6-svg kauth kcrash kconfig ki18n kcmutils knewstuff kio knotifications knotifyconfig attica krunner kglobalaccel kcoreaddons kguiaddons kdbusaddons kwidgetsaddons kcodecs sonnet kpackage kiconthemes kxmlgui ksvg plasma5support libplasma plasma-activities plasma-activities-stats kirigami qqc2-desktop-style wayland-protocols wayland plasma-workspace kwin kscreenlocker kitemmodels libksysguard kded libx11 libcanberra systemd libxcb glib kirigami-addons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/plasma-desktop-$pkgver.tar.xz")
sha256sums=('7552e4c7c7ccbf5b7756726bb9aaabd344630977aaf13f5f305b4477caa17bb7')

build() {
    cmake -S plasma-desktop-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DOC=OFF -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-desktop-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
