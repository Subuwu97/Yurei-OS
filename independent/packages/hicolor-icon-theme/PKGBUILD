# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=hicolor-icon-theme
pkgver=0.18
pkgrel=1
pkgdesc="The base icon theme every program's icons go into"
arch=(any)
url="https://www.freedesktop.org/wiki/Software/icon-theme/"
license=(GPL-2.0-only)
source=("https://icon-theme.freedesktop.org/releases/hicolor-icon-theme-$pkgver.tar.xz")
sha256sums=('db0e50a80aa3bf64bb45cbca5cf9f75efd9348cf2ac690b907435238c3cf81d7')

build() {
    meson setup hicolor-icon-theme-$pkgver build --prefix=/usr
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
