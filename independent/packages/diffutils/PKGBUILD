# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=diffutils
pkgver=3.12
pkgrel=1
pkgdesc="Utility programs used for creating patch files"
arch=(x86_64)
url="https://www.gnu.org/software/diffutils/"
license=(GPL-3.0-or-later)
depends=(glibc)
source=("https://ftp.gnu.org/gnu/diffutils/diffutils-$pkgver.tar.xz")
sha256sums=('7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd')

build() {
    cd diffutils-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd diffutils-$pkgver
    make DESTDIR="$pkgdir" install
}
