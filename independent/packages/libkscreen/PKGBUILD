# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=libkscreen
_lockname=plasma-libkscreen
pkgver=6.4.5
pkgrel=1
pkgdesc="Display configuration library"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.1-or-later)
depends=(qt6-base qt6-wayland wayland plasma-wayland-protocols libxcb)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/libkscreen-$pkgver.tar.xz")
sha256sums=('68d26e27656b450f15a78f44784c50a22034e57c14f96a402019d52bc5b3e2b4')

build() {
    cmake -S libkscreen-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a libkscreen-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
