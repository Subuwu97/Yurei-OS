# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kbookmarks
_lockname=kf6-kbookmarks
pkgver=6.18.0
pkgrel=1
pkgdesc="Desktop bookmark support"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons kwidgetsaddons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kbookmarks-$pkgver.tar.xz")
sha256sums=('41a845ffd9effb8d942d04d76fc3a58b0bf23d3fd36aeba21c89ab9eb0fc4f85')

build() {
    cmake -S kbookmarks-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kbookmarks-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
