# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=qqc2-desktop-style
_lockname=kf6-qqc2-desktop-style
pkgver=6.18.0
pkgrel=1
pkgdesc="Native desktop styling for Qt Quick Controls"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.0-or-later LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base qt6-declarative kconfig kirigami kiconthemes kcolorscheme libx11)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/qqc2-desktop-style-$pkgver.tar.xz")
sha256sums=('91a60e0fefa294a337f2519c77ff2405b86eff99f3ea0e8fc3e34265ef4670f2')

build() {
    cmake -S qqc2-desktop-style-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a qqc2-desktop-style-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
