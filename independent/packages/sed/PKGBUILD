# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=sed
pkgver=4.9
pkgrel=1
pkgdesc="GNU stream editor"
arch=(x86_64)
url="https://www.gnu.org/software/sed/"
license=(GPL-3.0-or-later)
depends=(glibc acl attr)
source=("https://ftp.gnu.org/gnu/sed/sed-$pkgver.tar.xz")
sha256sums=('6e226b732e1cd739464ad6862bd1a1aba42d7982922da7a53519631d24975181')

build() {
    cd sed-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd sed-$pkgver
    make DESTDIR="$pkgdir" install
}
