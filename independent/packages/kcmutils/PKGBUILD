# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kcmutils
_lockname=kf6-kcmutils
pkgver=6.18.0
pkgrel=1
pkgdesc="System Settings module framework"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause BSD-3-Clause CC0-1.0 GPL-2.0-or-later LGPL-2.0-only LGPL-2.0-or-later LGPL-3.0-only)
depends=(qt6-base qt6-declarative kio kitemviews kconfigwidgets kcoreaddons kguiaddons ki18n kxmlgui kwidgetsaddons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kcmutils-$pkgver.tar.xz")
sha256sums=('6114c1ec8eb73734619a99e4956dce449828af336c2cd91d19bfeb03e221528f')

build() {
    cmake -S kcmutils-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kcmutils-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
