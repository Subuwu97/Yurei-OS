# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=expat
pkgver=2.7.1
pkgrel=1
pkgdesc="An XML parser library"
arch=(x86_64)
url="https://libexpat.github.io/"
license=(MIT)
depends=(glibc)
source=("https://github.com/libexpat/libexpat/releases/download/R_2_7_1/expat-$pkgver.tar.xz")
sha256sums=('354552544b8f99012e5062f7d570ec77f14b412a3ff5c7d8d0dae62c0d217c30')

build() {
    cd expat-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd expat-$pkgver
    make DESTDIR="$pkgdir" install
}
