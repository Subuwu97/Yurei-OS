# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kidletime); check-recipes.py keeps them the same.
pkgname=kidletime
_lockname=kf6-kidletime
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: idle time (screen lock, power saving)"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-wayland libxcb libx11)
makedepends=(extra-cmake-modules qt6-tools plasma-wayland-protocols wayland-protocols)
source=("https://download.kde.org/stable/frameworks/6.18/kidletime-$pkgver.tar.xz")
sha256sums=('44afc88543b23c519eb5f55e7c5120ccd6d4eb2eaaa5bee24e3fb5e4a695dab7')

build() {
    cmake -S kidletime-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
