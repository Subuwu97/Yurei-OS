# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as plasma-wayland-protocols); check-recipes.py keeps them the same.
pkgname=plasma-wayland-protocols
_lockname=plasma-wayland-protocols
pkgver=1.18.0
pkgrel=1
pkgdesc="Plasma's own Wayland protocols"
arch=(any)
url="https://kde.org/"
license=(LGPL-2.1-or-later)
depends=()
makedepends=(extra-cmake-modules)
source=("https://download.kde.org/stable/plasma-wayland-protocols/plasma-wayland-protocols-$pkgver.tar.xz")
sha256sums=('2567472671ad5d989f88b51baef9dd59353a5e7c3f2ed7e6b989755cb9004233')

build() {
    cmake -S plasma-wayland-protocols-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
