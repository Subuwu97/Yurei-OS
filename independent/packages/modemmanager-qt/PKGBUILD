# Maintainer: Yurei Linux project
pkgname=modemmanager-qt
_lockname=kf6-modemmanager-qt
pkgver=6.18.0
pkgrel=1
pkgdesc="modemmanager-qt: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base modemmanager)
source=("https://download.kde.org/stable/frameworks/6.18/modemmanager-qt-$pkgver.tar.xz")
sha256sums=('c8c0c1c6d6c815efa11b8e31bbb3f5e8014789d7e0babfa1574280be6791d013')

build() {
    cmake -S modemmanager-qt-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF 
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a modemmanager-qt-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
