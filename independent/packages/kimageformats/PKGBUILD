# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kimageformats
_lockname=kf6-kimageformats
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kimageformats"
arch=(x86_64)
url="https://kde.org/"
license=(Apache-2.0 BSD-2-Clause BSD-3-Clause CC0-1.0 LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base karchive)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kimageformats-$pkgver.tar.xz")
sha256sums=('9d373ef5362aa8d71541cec2895415c95ca914626dcb0dd6b0ceef491dcbae46')

build() {
    cmake -S kimageformats-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kimageformats-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
