# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kcolorscheme
_lockname=kf6-kcolorscheme
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kcolorscheme"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause CC-BY-SA-4.0 CC0-1.0 LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base kconfig kguiaddons ki18n)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kcolorscheme-$pkgver.tar.xz")
sha256sums=('14e99e74cc636640ac8d705f2878d72d0379fff671e75c0f138302489898d651')

build() {
    cmake -S kcolorscheme-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kcolorscheme-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
