#!/bin/sh
# yurei-dxvk [install|remove]: puts DXVK's Direct3D DLLs into a Wine prefix
# (WINEPREFIX, or ~/.wine) and tells Wine to use them, or takes them out
# again so Wine's own (OpenGL-based) Direct3D is used.
set -e
action=${1:-install}
prefix=${WINEPREFIX:-$HOME/.wine}
dxvk=/usr/share/dxvk
dlls="d3d8 d3d9 d3d10core d3d11 dxgi"
case $action in
    install|remove) ;;
    *) echo "usage: yurei-dxvk [install|remove]   (the prefix is \$WINEPREFIX, or ~/.wine)" >&2; exit 2 ;;
esac
export WINEPREFIX=$prefix WINEDEBUG=-all
[ -d "$prefix/drive_c/windows" ] || wineboot -i
sys64=$prefix/drive_c/windows/system32
sys32=$prefix/drive_c/windows/syswow64
for dll in $dlls; do
    if [ "$action" = install ]; then
        cp "$dxvk/x64/$dll.dll" "$sys64/$dll.dll"
        [ -d "$sys32" ] && cp "$dxvk/x32/$dll.dll" "$sys32/$dll.dll"
        wine reg add 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v "$dll" /d native /f > /dev/null
    else
        wine reg delete 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v "$dll" /f > /dev/null 2>&1 || true
    fi
done
# Wine puts its own DLLs back on the next update of the prefix
[ "$action" = remove ] && wineboot -u
echo "DXVK ${action}ed in $prefix"
