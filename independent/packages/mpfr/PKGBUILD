# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=mpfr
pkgver=4.2.2
pkgrel=1
pkgdesc="Multiple-precision floating-point library"
arch=(x86_64)
url="https://www.mpfr.org/"
license=(LGPL-3.0-or-later)
depends=(gmp glibc)
source=("https://ftp.gnu.org/gnu/mpfr/mpfr-$pkgver.tar.xz")
sha256sums=('b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01')

build() {
    cd mpfr-$pkgver
    ./configure --prefix=/usr --disable-static --enable-thread-safe
    make
}

package() {
    cd mpfr-$pkgver
    make DESTDIR="$pkgdir" install
}
