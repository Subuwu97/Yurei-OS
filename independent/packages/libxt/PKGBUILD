# Maintainer: Yurei Linux project
pkgname=libxt
pkgver=1.3.1
pkgrel=1
pkgdesc="X Toolkit Intrinsics used by Firefox"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(libx11 libice libsm)
source=("https://xorg.freedesktop.org/archive/individual/lib/libXt-$pkgver.tar.xz")
sha256sums=('e0a774b33324f4d4c05b199ea45050f87206586d81655f8bef4dba434d931288')
build() {
    cd libXt-$pkgver
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --disable-static --disable-specs
    make
}
package() {
    cd libXt-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
