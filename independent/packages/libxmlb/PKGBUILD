# Maintainer: Yurei Linux project
pkgname=libxmlb
pkgver=0.3.29
pkgrel=1
pkgdesc="libxmlb: application store and sandboxed desktop support"
arch=(x86_64)
url="https://github.com/hughsie/libxmlb/releases/download/0.3.29"
license=(LGPL-2.1-or-later)
depends=(glib xz zstd)
source=("https://github.com/hughsie/libxmlb/releases/download/0.3.29/libxmlb-0.3.29.tar.xz")
sha256sums=('448294be33bfae62f00fa66e506f1cae80237ce71b7ab6530aefa75005eeb08a')

build() {
    meson setup libxmlb-0.3.29 build --prefix=/usr --libdir=lib --libexecdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nofallback -Dgtkdoc=false -Dintrospection=false -Dtests=false -Dstemmer=false
    meson compile -C build
}
package() {
    DESTDIR="$pkgdir" meson install -C build
}
