# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=breeze
_lockname=plasma-breeze
pkgver=6.4.5
pkgrel=1
pkgdesc="Breeze widgets cursors and window decorations"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only MIT)
depends=(qt6-base qt6-svg qt6-declarative kcoreaddons kcolorscheme kconfig kguiaddons ki18n kiconthemes kwindowsystem kirigami kcmutils kdecoration)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/breeze-$pkgver.tar.xz")
sha256sums=('dcb8433d399511546958f4c8c1a8fae5ed22f2a698f053968d410ee75bd6d8b4')

build() {
    cmake -S breeze-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_QT5=OFF -DBUILD_QT6=ON -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a breeze-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
