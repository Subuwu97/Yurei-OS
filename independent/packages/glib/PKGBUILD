# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=glib
pkgver=2.84.1
pkgrel=1
pkgdesc="GLib: the base library of GTK desktop programs"
arch=(x86_64)
url="https://gitlab.gnome.org/GNOME/glib"
license=(LGPL-2.1-or-later)
depends=(glibc pcre2 libffi zlib util-linux)
source=("https://download.gnome.org/sources/glib/2.84/glib-$pkgver.tar.xz")
sha256sums=('2b4bc2ec49611a5fc35f86aca855f2ed0196e69e53092bab6bb73396bf30789a')

build() {
    meson setup glib-$pkgver build --prefix=/usr --buildtype=release \
        -D introspection=disabled -D man-pages=disabled -D tests=false -D sysprof=disabled -D selinux=disabled -D glib_debug=disabled
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
