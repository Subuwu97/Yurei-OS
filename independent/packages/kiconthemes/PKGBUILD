# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kiconthemes
_lockname=kf6-kiconthemes
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kiconthemes"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative qt6-svg karchive ki18n kwidgetsaddons kcolorscheme breeze-icons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kiconthemes-$pkgver.tar.xz")
sha256sums=('b971460949fafc98e7ae293f35635c2fd6101a6fc46b2f4fce64bb21440ece04')

build() {
    cmake -S kiconthemes-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kiconthemes-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
