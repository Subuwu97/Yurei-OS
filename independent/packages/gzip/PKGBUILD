# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=gzip
pkgver=1.14
pkgrel=1
pkgdesc="GNU compression utility"
arch=(x86_64)
url="https://www.gnu.org/software/gzip/"
license=(GPL-3.0-or-later)
depends=(glibc bash)
source=("https://ftp.gnu.org/gnu/gzip/gzip-$pkgver.tar.xz")
sha256sums=('01a7b881bd220bfdf615f97b8718f80bdfd3f6add385b993dcf6efd14e8c0ac6')

build() {
    cd gzip-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd gzip-$pkgver
    make DESTDIR="$pkgdir" install
}
