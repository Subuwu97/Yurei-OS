# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=zlib
pkgver=1.3.1
pkgrel=1
pkgdesc="Compression library implementing the deflate method"
arch=(x86_64)
url="https://zlib.net/"
license=(Zlib)
depends=(glibc)
source=("https://zlib.net/fossils/zlib-$pkgver.tar.gz")
sha256sums=('9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23')

build() {
    cd zlib-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd zlib-$pkgver
    make DESTDIR="$pkgdir" install
    rm -f "$pkgdir/usr/lib/libz.a"
}
