# Maintainer: Yurei Linux project
pkgname=libqrencode
pkgver=4.1.1
pkgrel=1
pkgdesc="QR code encoder for Plasma"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(LGPL-2.1-or-later)
depends=(glibc libpng)
source=("libqrencode-$pkgver.tar.gz::https://github.com/fukuchi/libqrencode/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c')

build() {
    cmake -S libqrencode-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON -DWITH_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 libqrencode-$pkgver/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
