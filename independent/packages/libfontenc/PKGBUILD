# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libfontenc
pkgver=1.1.8
pkgrel=1
pkgdesc="X11 font encoding library"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(zlib)
source=("https://www.x.org/releases/individual/lib/libfontenc-$pkgver.tar.xz")
sha256sums=('7b02c3d405236e0d86806b1de9d6868fe60c313628b38350b032914aa4fd14c6')

build() {
    cd libfontenc-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
    make
}

package() {
    cd libfontenc-$pkgver
    make DESTDIR="$pkgdir" install
}
