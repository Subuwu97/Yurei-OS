# Maintainer: Yurei Linux project
pkgname=powerdevil
_lockname=plasma-powerdevil
pkgver=6.4.5
pkgrel=1
pkgdesc="powerdevil: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(BSD-2-Clause BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only GPL-3.0-or-later LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only MIT)
depends=(qt6-base qt6-wayland qcoro kauth kconfig kcrash kdbusaddons ki18n kidletime kitemmodels kglobalaccel kio kirigami kcmutils knotifications krunner solid kwindowsystem kxmlgui libplasma plasma-activities libkscreen plasma-workspace systemd libxcb wayland plasma-wayland-protocols upower)
source=("https://download.kde.org/stable/plasma/$pkgver/powerdevil-$pkgver.tar.xz")
sha256sums=('aa8e9c6f33b8aed4edae9c9c43830966ed4eec2fb437cf21023150bdfbd82e48')

build() {
    cmake -S powerdevil-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a powerdevil-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
