# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kcodecs); check-recipes.py keeps them the same.
pkgname=kcodecs
_lockname=kf6-kcodecs
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: text encodings"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kcodecs-$pkgver.tar.xz")
sha256sums=('247eda9ade502699062c7baaca7bb93691a308f202c165954652875ebe777426')

build() {
    cmake -S kcodecs-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
