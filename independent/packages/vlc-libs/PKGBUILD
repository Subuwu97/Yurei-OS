# Maintainer: Yurei Linux project
pkgname=vlc-libs
pkgver=3.0.21
pkgrel=1
pkgdesc="VLC audio playback libraries for the Phonon backend"
arch=(x86_64)
url="https://www.videolan.org/"
license=(GPL-2.0-or-later LGPL-2.1-or-later)
depends=(glibc gcc-libs libogg libvorbis flac opus libpulse alsa-lib libgcrypt gnutls libpng libjpeg-turbo freetype fontconfig harfbuzz zlib)
source=("https://download.videolan.org/pub/videolan/vlc/$pkgver/vlc-$pkgver.tar.xz")
sha256sums=('24dbbe1d7dfaeea0994d5def0bbde200177347136dbfe573f5b6a4cee25afbb0')

build() {
    cd vlc-$pkgver
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --libdir=/usr/lib --disable-nls \
        --disable-vlc --disable-qt --disable-skins2 --disable-lua --disable-dbus \
        --disable-avcodec --disable-avformat --disable-swscale --disable-postproc \
        --disable-live555 --disable-v4l2 --disable-screen --disable-xcb --disable-wayland \
        --disable-vdpau --disable-libva --disable-ncurses --disable-sout --disable-vlm \
        --disable-addonmanagermodules --enable-pulse --enable-alsa
    make
}

package() {
    cd vlc-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
    install -Dm644 COPYING.LIB "$pkgdir/usr/share/licenses/$pkgname/COPYING.LIB"
}
