# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=acl
pkgver=2.3.2
pkgrel=1
pkgdesc="Access control list utilities, libraries and headers"
arch=(x86_64)
url="https://savannah.nongnu.org/projects/acl"
license=(LGPL-2.1-or-later GPL-2.0-or-later)
depends=(attr glibc)
source=("https://download.savannah.nongnu.org/releases/acl/acl-$pkgver.tar.xz")
sha256sums=('97203a72cae99ab89a067fe2210c1cbf052bc492b479eca7d226d9830883b0bd')

build() {
    cd acl-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd acl-$pkgver
    make DESTDIR="$pkgdir" install
}
