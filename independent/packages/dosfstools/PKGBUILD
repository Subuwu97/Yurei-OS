# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=dosfstools
pkgver=4.2
pkgrel=1
pkgdesc="Tools for FAT file systems, such as EFI partitions (mkfs.fat, fsck.fat)"
arch=(x86_64)
url="https://github.com/dosfstools/dosfstools"
license=(GPL-3.0-or-later)
depends=(glibc)
source=("https://github.com/dosfstools/dosfstools/releases/download/v$pkgver/dosfstools-$pkgver.tar.gz")
sha256sums=('64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527')

build() {
    cd dosfstools-$pkgver
    ./configure --prefix=/usr --enable-compat-symlinks --mandir=/usr/share/man
    make
}

package() {
    cd dosfstools-$pkgver
    make DESTDIR="$pkgdir" install
}
