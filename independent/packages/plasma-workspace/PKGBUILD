# Maintainer: Yurei Linux project
pkgname=plasma-workspace
_lockname=plasma-plasma-workspace
pkgver=6.4.5
pkgrel=3
pkgdesc="Plasma shell panels task manager and Wayland session"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only LGPL-3.0-or-later MIT)
depends=(qt6-base qt6-declarative qt6-5compat qt6-location qt6-positioning qt6-shadertools qt6-svg qt6-wayland qcoro karchive kauth kcoreaddons kcrash kdbusaddons kdeclarative kglobalaccel kguiaddons ki18n kiconthemes kitemmodels kcmutils kded kio knewstuff knotifications knotifyconfig kpackage kparts prison krunner kstatusnotifieritem ksvg ktexteditor ktextwidgets kunitconversion kwallet kcolorscheme plasma5support libplasma kwayland plasma-activities plasma-activities-stats libksysguard libkscreen layer-shell-qt kwin kscreenlocker phonon-qt6 phonon-vlc-qt6 libcanberra breeze zlib fontconfig libx11 libxcb xcb-util xcb-util-cursor xcb-util-image plasma-wayland-protocols wayland systemd polkit-qt6 kirigami kquickcharts kuserfeedback kholidays networkmanager-qt kirigami-addons upower icu)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/plasma-workspace-$pkgver.tar.xz")
sha256sums=('19999ebf3574f539145ba7074019b88d51f2ca952d121394daf6af2e632910fb')

build() {
    cmake -S plasma-workspace-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DPLASMA_X11_DEFAULT_SESSION=OFF -DGLIBC_LOCALE_GEN=OFF -DGLIBC_LOCALE_PREGENERATED=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # This image has Xwayland, but no standalone Xorg session.
    rm -f "$pkgdir/usr/share/xsessions/plasmax11.desktop"
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-workspace-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
