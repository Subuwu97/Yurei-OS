# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kpty
_lockname=kf6-kpty
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kpty"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-or-later LGPL-2.0-or-later)
depends=(qt6-base kcoreaddons ki18n)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kpty-$pkgver.tar.xz")
sha256sums=('3f800638fcc0dbea0810930a1f2decfa6b894bb00732ff8646182c7dfd2ac76d')

build() {
    cmake -S kpty-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF -DCMAKE_DISABLE_FIND_PACKAGE_UTEMPTER=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kpty-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
