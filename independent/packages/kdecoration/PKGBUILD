# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kdecoration
_lockname=plasma-kdecoration
pkgver=6.4.5
pkgrel=1
pkgdesc="Window decoration framework"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base ki18n)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/kdecoration-$pkgver.tar.xz")
sha256sums=('f9d3ec4256cf7125a3b0bc08c7737af715235d5c22b69ba29797bb06c5ef4a4c')

build() {
    cmake -S kdecoration-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kdecoration-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
