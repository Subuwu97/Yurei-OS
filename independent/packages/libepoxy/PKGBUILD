# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libepoxy
pkgver=1.5.10
pkgrel=1
pkgdesc="OpenGL function loading (GTK draws with it)"
arch=(x86_64)
url="https://github.com/anholt/libepoxy"
license=(MIT)
depends=(glibc mesa)
source=("https://download.gnome.org/sources/libepoxy/1.5/libepoxy-$pkgver.tar.xz")
sha256sums=('072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623')

build() {
    meson setup libepoxy-$pkgver build --prefix=/usr --buildtype=release \
        -D x11=false -D glx=no -D egl=yes -D tests=false -D docs=false
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
