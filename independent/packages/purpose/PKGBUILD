# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=purpose
_lockname=kf6-purpose
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE desktop sharing actions"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later LGPL-2.0-or-later LGPL-2.1-or-later)
depends=(qt6-base qt6-declarative kcoreaddons ki18n kconfig kirigami knotifications kio kservice)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/purpose-$pkgver.tar.xz")
sha256sums=('a428e4f495658240899e02f15b7a9230e3c33069723b43e1734c21fa1a23b825')

build() {
    cmake -S purpose-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a purpose-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
