# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=file
pkgver=5.46
pkgrel=1
pkgdesc="File type identification utility"
arch=(x86_64)
url="https://www.darwinsys.com/file/"
license=(BSD-2-Clause)
depends=(glibc zlib xz bzip2 zstd)
source=("https://astron.com/pub/file/file-$pkgver.tar.gz")
sha256sums=('c9cc77c7c560c543135edc555af609d5619dbef011997e988ce40a3d75d86088')

build() {
    cd file-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd file-$pkgver
    make DESTDIR="$pkgdir" install
}
