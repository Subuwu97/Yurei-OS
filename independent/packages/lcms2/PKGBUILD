# Maintainer: Yurei Linux project
pkgname=lcms2
pkgver=2.17
pkgrel=1
pkgdesc="lcms2 support library for Plasma"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(MIT)
depends=(glibc)
source=("https://github.com/mm2/Little-CMS/releases/download/lcms$pkgver/lcms2-$pkgver.tar.gz")
sha256sums=('d11af569e42a1baa1650d20ad61d12e41af4fead4aa7964a01f93b08b53ab074')

build() {
    cd lcms2-$pkgver
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make
}

package() {
    cd lcms2-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 lcms2-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
