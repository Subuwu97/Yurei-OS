# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=plasma-activities
_lockname=plasma-plasma-activities
pkgver=6.4.5
pkgrel=2
pkgdesc="Activities library and QML bindings"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only MIT)
depends=(qt6-base qt6-declarative)
makedepends=(extra-cmake-modules qt6-tools boost-headers)
source=("https://download.kde.org/stable/plasma/6.4.5/plasma-activities-$pkgver.tar.xz")
sha256sums=('30ad23846e97bf3c2ed6d3af25de0ae1d981ea871608492fcc16155efd0c8169')

build() {
    cmake -S plasma-activities-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-activities-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
