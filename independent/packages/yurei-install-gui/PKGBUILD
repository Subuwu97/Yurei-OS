# Maintainer: Yurei Linux project
pkgname=yurei-install-gui
pkgver=0.1
pkgrel=2
pkgdesc="Graphical installer for the independent Yurei live system"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(GPL-3.0-or-later CC-BY-SA-4.0)
depends=(qt6-base gcc-libs yurei-install polkit)
makedepends=(cmake ninja)

build() {
    cmake -S "$startdir" -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
