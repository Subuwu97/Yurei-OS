# Maintainer: Yurei Linux project
pkgname=plasma-pa
_lockname=plasma-plasma-pa
pkgver=6.4.5
pkgrel=1
pkgdesc="plasma-pa: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative kconfig kcoreaddons kdeclarative kglobalaccel kstatusnotifieritem ki18n kcmutils ksvg kdbusaddons libplasma libcanberra pulseaudio-qt kirigami kirigami-addons kitemmodels)
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-pa-$pkgver.tar.xz")
sha256sums=('14c2bacff0f01c0b528d7b71b5062c68b2972bb415b5c27387dd35cee4441b1a')

build() {
    cmake -S plasma-pa-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DBUILD_DOC=OFF -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-pa-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
