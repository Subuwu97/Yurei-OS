# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=xkbcomp
pkgver=1.4.7
pkgrel=1
pkgdesc="X11 keymap compiler, which Xwayland runs"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(libx11 libxkbfile)
source=("https://www.x.org/releases/individual/app/xkbcomp-$pkgver.tar.xz")
sha256sums=('0a288114e5f44e31987042c79aecff1ffad53a8154b8ec971c24a69a80f81f77')

build() {
    cd xkbcomp-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
    make
}

package() {
    cd xkbcomp-$pkgver
    make DESTDIR="$pkgdir" install
}
