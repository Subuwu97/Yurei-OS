# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=xcb-proto
pkgver=1.17.0
pkgrel=1
pkgdesc="XCB protocol descriptions and Python generator"
arch=(any)
url="https://www.x.org/"
license=(MIT)
depends=(python)
source=("https://www.x.org/releases/individual/proto/xcb-proto-$pkgver.tar.xz")
sha256sums=('2c1bacd2110f4799f74de6ebb714b94cf6f80fb112316b1219480fd22562148c')

build() {
    cd xcb-proto-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
    make
}

package() {
    cd xcb-proto-$pkgver
    make DESTDIR="$pkgdir" install
}
