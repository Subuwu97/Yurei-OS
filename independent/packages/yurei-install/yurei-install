#!/bin/bash
# Installs Yūrei from the live system onto a whole disk, which it erases:
# a 1 GiB EFI partition (systemd-boot and the kernel) and the rest for
# Yūrei (ext4). The installed system is the live system as it was built,
# with its own name, user and passwords, and without the live settings.
#
#   yurei-install                       asks everything
#   yurei-install --disk /dev/nvme0n1 --hostname NAME --user NAME [--yes]
#
# Unattended (tests): the passwords come from $YUREI_USER_PASSWORD and
# $YUREI_ROOT_PASSWORD, and --kernel-options adds to the kernel's options.
set -euo pipefail

target=/mnt/yurei-target
rootfs=/run/live/rootfs
disk='' hostname='' user='' yes='' kernel_options=''
passwords_stdin='' expected_disk_bytes='' expected_disk_device=''

die() { echo "yurei-install: $*" >&2; exit 1; }
say() { printf '\n== %s\n' "$*"; }

while (( $# )); do
    case $1 in
        --disk) disk=$2; shift ;;
        --hostname) hostname=$2; shift ;;
        --user) user=$2; shift ;;
        --kernel-options) kernel_options=$2; shift ;;
        --yes) yes=1 ;;
        --passwords-stdin) passwords_stdin=1 ;;
        --expected-disk-bytes) expected_disk_bytes=$2; shift ;;
        --expected-disk-device) expected_disk_device=$2; shift ;;
        -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option $1 (see --help)" ;;
    esac
    shift
done

[[ $EUID -eq 0 ]] || die "run as root"
[[ -d /sys/firmware/efi ]] || die "this PC started in legacy BIOS mode; Yūrei installs for UEFI only (start the live system in UEFI mode)"
mountpoint -q "$rootfs" || die "run from the Yūrei live system ($rootfs isn't there)"
exec 9>/run/yurei-install.lock
flock -n 9 || die "another installation is already running"

# --- which disk ------------------------------------------------------------

# the disk the live system runs from (the ISO itself, or the stick holding
# the ISO file); it can't be the target
live_disk() {
    local src
    src=$(findmnt -no SOURCE /run/live/host 2>/dev/null || findmnt -no SOURCE /run/live/medium)
    [[ -b $src ]] || return 0
    lsblk -no PKNAME "$src" 2>/dev/null | head -n1 | sed 's|^|/dev/|;s|^/dev/$||'
    [[ $(lsblk -no TYPE "$src") == disk ]] && echo "$src"
    return 0
}

mapfile -t live < <(live_disk)
disks=()
while read -r name type; do
    [[ $type == disk ]] || continue
    for l in "${live[@]}"; do [[ $name == "$l" ]] && continue 2; done
    disks+=("$name")
done < <(lsblk -dpno NAME,TYPE -e 1,7,11)
(( ${#disks[@]} )) || die "no disk to install to (the live system's own disk isn't offered)"

if [[ -z $disk ]]; then
    echo "Yūrei installs onto a whole disk, which is ERASED: everything on it is lost."
    echo "Disks:"
    i=0
    for d in "${disks[@]}"; do
        i=$((i + 1))
        printf '  %d) %s  %s  %s\n' "$i" "$d" "$(lsblk -dno SIZE "$d" | tr -d ' ')" "$(lsblk -dno MODEL "$d")"
    done
    read -rp "Install onto which disk (number)? " n
    if ! [[ $n =~ ^[0-9]+$ ]] || (( n < 1 || n > ${#disks[@]} )); then die "no such disk"; fi
    disk=${disks[n-1]}
fi
found=
for d in "${disks[@]}"; do [[ $d == "$disk" ]] && found=1; done
[[ -n $found ]] || die "$disk isn't a disk Yūrei can install to (choose from: ${disks[*]})"

check_target() {
    local bytes device mounts l
    [[ $(lsblk -dn -o TYPE "$disk") == disk ]] || die "the selected device is no longer a whole disk"
    [[ $(lsblk -dn -o RO "$disk" | tr -d '[:space:]') == 0 ]] || die "the selected disk is read-only"
    for l in $(live_disk); do [[ $disk != "$l" ]] || die "the selected disk holds the live system"; done
    mounts=$(lsblk -n -o MOUNTPOINTS "$disk" | sed '/^[[:space:]]*$/d')
    [[ -z $mounts ]] || die "unmount the selected disk's filesystems before installing"
    bytes=$(blockdev --getsize64 "$disk")
    device=$(lsblk -dn -o MAJ:MIN "$disk" | tr -d ' ')
    if [[ -n $expected_disk_bytes ]]; then
        [[ $expected_disk_bytes =~ ^[0-9]+$ && $bytes == "$expected_disk_bytes" ]] || die "the selected disk's size changed; select it again"
    fi
    if [[ -n $expected_disk_device ]]; then
        [[ $expected_disk_device =~ ^[0-9]+:[0-9]+$ && $device == "$expected_disk_device" ]] || die "the selected device changed; select it again"
    fi
    (( bytes >= required_bytes )) || die "the selected disk is too small for this live system"
}
live_bytes=$(du -sb "$rootfs" | cut -f1)
[[ $live_bytes =~ ^[0-9]+$ ]] || die "couldn't determine the live system's size"
required_bytes=$(( live_bytes + live_bytes / 5 + 1073741824 ))
check_target

# --- names and passwords ----------------------------------------------------

valid_name() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
while [[ -z $hostname ]]; do
    read -rp "Computer name [yurei]: " hostname
    hostname=${hostname:-yurei}
    [[ $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,62})$ ]] || { echo "Letters, digits and - only."; hostname=; }
done
[[ $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,62})$ ]] || die "invalid computer name"
while [[ -z $user ]]; do
    read -rp "Your user name (lower case): " user
    valid_name "$user" || { echo "Lower-case letters, digits, - and _ only, starting with a letter."; user=; }
done
valid_name "$user" || die "user name $user isn't valid"
[[ -f "$rootfs/etc/passwd" ]] || die "the live system has no account database"
grep -q '^wheel:' "$rootfs/etc/group" || die "the live system has no administrator group"
! grep -q "^$user:" "$rootfs/etc/passwd" || die "choose a new user name; $user already exists in the live system"

ask_password() {  # PROMPT VAR
    local a b
    while :; do
        read -rsp "$1: " a; echo
        read -rsp "Again: " b; echo
        [[ -n $a && $a == "$b" ]] && break
        echo "They're empty or don't match; once more."
    done
    printf -v "$2" '%s' "$a"
}
user_password=${YUREI_USER_PASSWORD:-}
root_password=${YUREI_ROOT_PASSWORD:-}
if [[ -n $passwords_stdin ]]; then
    IFS= read -r user_password || die "missing user password on standard input"
    IFS= read -r root_password || die "missing administrator password on standard input"
    [[ -n $user_password && -n $root_password ]] || die "passwords must not be empty"
fi
[[ -n $user_password ]] || ask_password "Password for $user" user_password
[[ -n $root_password ]] || ask_password "Password for root (administrator)" root_password

if [[ -z $yes ]]; then
    echo
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MODEL "$disk"
    echo
    echo "Everything on $disk will be erased, and Yūrei installed as '$hostname' for $user."
    read -rp "Type ERASE to go ahead: " answer
    [[ $answer == ERASE ]] || die "nothing was changed"
fi

# --- partitions -------------------------------------------------------------

# Recheck after account entry and authorization, immediately before writing.
check_target
say "Partitioning $disk"
umount -R "$target" 2>/dev/null || true
for p in $(lsblk -lnpo NAME "$disk" | tail -n +2); do umount "$p" 2>/dev/null || true; done
wipefs -a -q "$disk"
# the root partition has the x86-64 root type, so systemd knows it's Yūrei
sfdisk -q --wipe always --label gpt "$disk" <<PARTS
size=1GiB, type=uefi, name="EFI system"
type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709, name="Yurei"
PARTS
udevadm settle 2>/dev/null || sleep 2
mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" | awk '$2 == "part" {print $1}')
(( ${#parts[@]} == 2 )) || die "the new partitions didn't appear"
esp=${parts[0]} root=${parts[1]}

say "Formatting"
mkfs.fat -F 32 -n YUREI_EFI "$esp" > /dev/null
mkfs.ext4 -q -F -L yurei "$root"

mkdir -p "$target"
mount "$root" "$target"
mkdir -p "$target/boot"
mount -o umask=0077 "$esp" "$target/boot"

# --- the system -------------------------------------------------------------

say "Copying Yūrei ($(du -sh "$rootfs" 2>/dev/null | cut -f1)); this takes a few minutes"
cp -a "$rootfs/." "$target/"
kernel=$(compgen -G "$target/usr/lib/modules/*/vmlinuz" | head -n1) || true
[[ -n $kernel ]] || die "no kernel in the live system"
install -m644 "$kernel" "$target/boot/vmlinuz-yurei"

say "Settings"
# the live settings out, the installed system's in
rm -rf "$target/etc/systemd/system/getty@tty1.service.d"
for unit in pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket; do
    rm -f "$target/etc/systemd/user/$unit.d/90-yurei-live-root.conf"
done
if [[ -f $target/etc/xdg/kwalletrc ]] && grep -qx '# Yurei live-only wallet policy' "$target/etc/xdg/kwalletrc"; then
    rm -f "$target/etc/xdg/kwalletrc"
fi
if [[ -f $target/etc/pam.d/system-login ]]; then
    # The live console permits its blank root password. Never carry that
    # live-only nullok policy into the installed system.
    cat > "$target/etc/pam.d/login" <<'PAM'
auth include system-login
account include system-login
password include system-login
session include system-login
PAM
fi
echo "$hostname" > "$target/etc/hostname"
printf '\n  Yūrei Linux (independent preview)\n\n' > "$target/etc/issue"
printf '\n  Welcome to Yūrei, built entirely from source by Yūrei itself.\n  Run administrator commands with sudo; Wi-Fi with iwctl.\n\n' > "$target/etc/motd"
: > "$target/etc/machine-id"  # a new one on the first start
cat > "$target/etc/fstab" <<FSTAB
# <device>                                <mount>  <type>  <options>        <dump> <pass>
UUID=$(blkid -s UUID -o value "$root")  /        ext4    defaults         0 1
UUID=$(blkid -s UUID -o value "$esp")                       /boot    vfat    umask=0077       0 2
FSTAB

# what the commands below need inside the new system; not /run, whose
# live medium mounts would keep it busy
# Isolate the target copies before any chroot command or recursive unmount.
# With systemd's shared mounts, cleanup of an ordinary rbind can otherwise
# unmount /dev/pts or /sys/fs/cgroup in the running live system as well.
for fs in proc sys dev; do
    mount --rbind "/$fs" "$target/$fs"
    mount --make-rslave "$target/$fs"
done
in_target() { chroot "$target" "$@"; }
# the system's groups (and the login screen's own user), then the user:
# an administrator (wheel), with the screen and input devices (seat) and
# sound, video and game controllers
in_target systemd-sysusers
groups=wheel
for group in seat video input audio render; do
    if in_target getent group "$group" >/dev/null; then groups+=,$group; fi
done
in_target useradd -m -G "$groups" -s /bin/bash "$user"
printf 'root:%s\n%s:%s\n' "$root_password" "$user" "$user_password" | in_target chpasswd

# Enable the login stack actually present in this image. SDDM takes priority
# once Plasma ships; older independent images can still install to a console.
if [[ -f $target/usr/lib/systemd/system/seatd.service ]]; then
    in_target systemctl enable seatd.service
fi
if [[ -f $target/usr/lib/systemd/system/sddm.service ]]; then
    in_target systemctl disable yurei-greeter.service >/dev/null 2>&1 || true
    in_target systemctl enable sddm.service
    in_target systemctl set-default graphical.target
elif [[ -f $target/usr/lib/systemd/system/yurei-greeter.service ]]; then
    in_target systemctl enable yurei-greeter.service
    in_target systemctl set-default graphical.target
else
    in_target systemctl set-default multi-user.target
fi

say "Boot menu (systemd-boot)"
# with a boot entry in the PC's firmware where it allows one; disks also
# start from the standard fallback, EFI/BOOT/BOOTX64.EFI, which it installs
boot_entry=1
mount -o remount,rw /sys/firmware/efi/efivars 2>/dev/null || true
if ! bootctl --esp-path="$target/boot" --make-entry-directory=no install; then
    boot_entry=
    bootctl --esp-path="$target/boot" --make-entry-directory=no --no-variables install
fi
partuuid=$(blkid -s PARTUUID -o value "$root")
printf 'default yurei.conf\ntimeout 3\n' > "$target/boot/loader/loader.conf"
# no initramfs: disks, USB and ext4 are built into Yūrei's kernel
cat > "$target/boot/loader/entries/yurei.conf" <<ENTRY
title   Yūrei Linux
linux   /vmlinuz-yurei
options root=PARTUUID=$partuuid rw${kernel_options:+ $kernel_options}
ENTRY

# (sys/fs/cgroup stays busy while systemd runs; it's let go lazily)
for fs in dev sys proc; do umount -R "$target/$fs" 2>/dev/null || umount -R -l "$target/$fs"; done
sync
umount -R "$target"

echo
echo "Yūrei is installed on $disk."
[[ -n $boot_entry ]] || echo "(The PC's boot list wasn't changed; choose the disk in its boot menu.)"
echo "Shut down (poweroff), remove the USB stick, and start the PC again."
