# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-ki18n); check-recipes.py keeps them the same.
pkgname=ki18n
_lockname=kf6-ki18n
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: translations (gettext)"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-declarative gettext)
makedepends=(extra-cmake-modules qt6-tools python)
source=("https://download.kde.org/stable/frameworks/6.18/ki18n-$pkgver.tar.xz")
sha256sums=('d0cbfbf3427c0368daa23f9f68b3cb5b03ad37b6820591491b3ea8a0a28bea61')

build() {
    cmake -S ki18n-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
