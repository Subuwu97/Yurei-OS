# Maintainer: Yurei Linux project
pkgname=pipewire-module-xrdp
pkgver=0.1
pkgrel=1
pkgdesc="Hyper-V enhanced session support: pipewire-module-xrdp"
arch=(x86_64)
url="https://github.com/neutrinolabs/pipewire-module-xrdp/archive/refs/tags"
license=(MIT)
depends=(pipewire xrdp)
source=("pipewire-module-xrdp-0.1.tar.gz::https://github.com/neutrinolabs/pipewire-module-xrdp/archive/refs/tags/v0.1.tar.gz")
sha256sums=('a85b6b17643452790af3e53966a885650feeeef9c59c24e5c82924a62eeacf8f')

build() {
    cd pipewire-module-xrdp-$pkgver
    ./bootstrap
    ./configure --prefix=/usr --libdir=/usr/lib --libexecdir=/usr/lib \
        --with-module-dir=/usr/lib/pipewire-0.3 --disable-alt-pw-cli
    make
}
package() {
    cd pipewire-module-xrdp-$pkgver
    make DESTDIR="$pkgdir" install
}
