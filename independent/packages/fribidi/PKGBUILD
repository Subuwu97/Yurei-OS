# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=fribidi
pkgver=1.0.16
pkgrel=1
pkgdesc="Right-to-left text (Arabic, Hebrew)"
arch=(x86_64)
url="https://github.com/fribidi/fribidi"
license=(LGPL-2.1-or-later)
depends=(glibc)
source=("https://github.com/fribidi/fribidi/releases/download/v$pkgver/fribidi-$pkgver.tar.xz")
sha256sums=('1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c')

build() {
    meson setup fribidi-$pkgver build --prefix=/usr --buildtype=release \
        -D docs=false -D tests=false
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
