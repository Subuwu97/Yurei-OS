# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-syntax-highlighting); check-recipes.py keeps them the same.
pkgname=syntax-highlighting
_lockname=kf6-syntax-highlighting
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: syntax highlighting"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-declarative)
makedepends=(extra-cmake-modules qt6-tools perl)
source=("https://download.kde.org/stable/frameworks/6.18/syntax-highlighting-$pkgver.tar.xz")
sha256sums=('8be8057221a982c8d1fe42f95454fac9610eb51975226c6652689293cd335bfd')

build() {
    cmake -S syntax-highlighting-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
