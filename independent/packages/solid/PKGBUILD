# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-solid); check-recipes.py keeps them the same.
pkgname=solid
_lockname=kf6-solid
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: hardware (disks, batteries, devices)"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-declarative systemd util-linux)
makedepends=(extra-cmake-modules qt6-tools flex bison)
source=("https://download.kde.org/stable/frameworks/6.18/solid-$pkgver.tar.xz")
sha256sums=('7768c1da7ee34a9e37cfb6b5b727e690c80134ca424b5262e403e48ccf812ddf')

build() {
    cmake -S solid-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
