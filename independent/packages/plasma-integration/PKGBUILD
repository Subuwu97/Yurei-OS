# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=plasma-integration
_lockname=plasma-plasma-integration
pkgver=6.4.5
pkgrel=1
pkgdesc="plasma-integration: consistent KDE application appearance"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base qt6-declarative qt6-wayland wayland plasma-wayland-protocols libxcb kconfig kconfigwidgets ki18n kiconthemes kio knotifications kwindowsystem kguiaddons kxmlgui kstatusnotifieritem kcolorscheme frameworkintegration)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/plasma-integration-$pkgver.tar.xz")
sha256sums=('c3e271de1fa26c8833440b69ccac5e8c094a85e4742bf26f97bcb7caa8c17b2c')

build() {
    cmake -S plasma-integration-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_QT5=OFF -DBUILD_QT6=ON -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-integration-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
