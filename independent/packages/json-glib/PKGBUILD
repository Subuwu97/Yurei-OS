# Maintainer: Yurei Linux project
pkgname=json-glib
pkgver=1.10.6
pkgrel=1
pkgdesc="json-glib: application store and sandboxed desktop support"
arch=(x86_64)
url="https://download.gnome.org/sources/json-glib/1.10"
license=(LGPL-2.1-or-later)
depends=(glib)
source=("https://download.gnome.org/sources/json-glib/1.10/json-glib-1.10.6.tar.xz")
sha256sums=('77f4bcbf9339528f166b8073458693f0a20b77b7059dbc2db61746a1928b0293')

build() {
    meson setup json-glib-1.10.6 build --prefix=/usr --libdir=lib --libexecdir=lib --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nofallback -Dintrospection=disabled -Ddocumentation=disabled -Dtests=false -Dconformance=false -Dinstalled_tests=false
    meson compile -C build
}
package() {
    DESTDIR="$pkgdir" meson install -C build
}
