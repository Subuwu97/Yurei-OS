# Maintainer: Yurei Linux project
pkgname=networkmanager-qt
_lockname=kf6-networkmanager-qt
pkgver=6.18.0
pkgrel=1
pkgdesc="networkmanager-qt: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-3.0-only LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative networkmanager glib)
source=("https://download.kde.org/stable/frameworks/6.18/networkmanager-qt-$pkgver.tar.xz")
sha256sums=('492836a74a03ba43facf52e827428f888f13d6e2bb8374819869707280a0310c')

build() {
    cmake -S networkmanager-qt-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF 
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a networkmanager-qt-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
