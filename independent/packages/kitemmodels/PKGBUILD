# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kitemmodels); check-recipes.py keeps them the same.
pkgname=kitemmodels
_lockname=kf6-kitemmodels
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: item models"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-declarative)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kitemmodels-$pkgver.tar.xz")
sha256sums=('887653b1571ad0afd4b836ad2451a42b07657d0eede1a2628e9c69102ce23de1')

build() {
    cmake -S kitemmodels-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
