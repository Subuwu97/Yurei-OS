# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 4, gaming; docs/INDEPENDENT.md). vkd3d-proton
# runs Direct3D 12 games on Vulkan, inside Wine; built for 64- and 32-bit
# Windows with the MinGW-w64 cross compilers, as DXVK is. Its GitHub
# archive has no submodules, so they come as their own archives at the
# commits vkd3d-proton 2.14.1 records (SPIRV-Headers 8b246ff is the same
# one DXVK uses). The source addresses and sums are the ones in
# independent/bootstrap/sources.lock; check-recipes.py checks the first.
pkgname=vkd3d-proton
pkgver=2.14.1
_dxilspirv=33cd5b2eee8a27da50ad7ed2762e56cca3a7b2c9
_dxilspirv_headers=ec59c77a3bb5c747a369931ef101ac7c14823f2f
_vulkan=29f979ee5aa58b7b005f805ea8df7a855c39ff37
_spirv=8b246ff75c6615ba4532fe4fde20f1be090c3764
# the v2.14.1 commit: the build number git describe gives in a checkout
_commit=0d66699b1b1e250ef19d793f2649d9288b0808ff
pkgrel=2
pkgdesc="Direct3D 12 on Vulkan, for Windows games in Wine (yurei-dxvk sets it up too)"
arch=(x86_64)
url="https://github.com/HansKristian-Work/vkd3d-proton"
license=(LGPL-2.1-or-later)
depends=(wine vulkan-icd-loader)
makedepends=(mingw-w64 glslang meson wine)
options=(!strip !buildflags !lto !debug)
source=("vkd3d-proton-$pkgver.tar.gz::https://github.com/HansKristian-Work/vkd3d-proton/archive/v$pkgver.tar.gz"
        "vkd3d-proton-dxil-spirv-$_dxilspirv.tar.gz::https://github.com/HansKristian-Work/dxil-spirv/archive/$_dxilspirv.tar.gz"
        "vkd3d-proton-spirv-headers-$_dxilspirv_headers.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_dxilspirv_headers.tar.gz"
        "vkd3d-proton-vulkan-headers-$_vulkan.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/$_vulkan.tar.gz"
        "dxvk-spirv-headers-$_spirv.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_spirv.tar.gz")
sha256sums=('30a39c2e487ea539afb996e260c063f68802a6338c52abc12dc95a52c45a65e1'
            '68c1e8b9c2e4b80e2f0308c676ef1ec519c3ee51d2f68fa5030bd8c352539db7'
            'c2a98de022539a77c11a8aee81ace958e53c668dfe6d9915f4f61e01f476139a'
            'dfc96c55d7e481c42b917706ff52205d47c0f0957c8c2a60766ee781f16d18bd'
            'cfeed5f9a97d12a9761a26e7f5bd10fedb1a8ce92033075151ae3bc7206fc229')

prepare() {
    cd vkd3d-proton-$pkgver
    rm -rf subprojects/dxil-spirv khronos/Vulkan-Headers khronos/SPIRV-Headers
    mv "$srcdir/dxil-spirv-$_dxilspirv" subprojects/dxil-spirv
    rm -rf subprojects/dxil-spirv/third_party/spirv-headers
    mv "$srcdir/SPIRV-Headers-$_dxilspirv_headers" subprojects/dxil-spirv/third_party/spirv-headers
    mv "$srcdir/Vulkan-Headers-$_vulkan" khronos/Vulkan-Headers
    mv "$srcdir/SPIRV-Headers-$_spirv" khronos/SPIRV-Headers
    # an archive isn't a git checkout, so meson's vcs_tag would fall back to
    # the version (0x2.14.1, not a number); give it the commit, as git would
    sed -i "s/@VCS_TAG@/${_commit:0:15}/" vkd3d_build.h.in
}

build() {
    local bits
    # widl, the IDL compiler, comes with Wine
    for bits in 64 86; do
        local cross=build-win$bits.txt
        [[ $bits == 86 ]] && cross=build-win32.txt
        meson setup "build$bits" vkd3d-proton-$pkgver --cross-file "vkd3d-proton-$pkgver/$cross" \
            --buildtype release --prefix /usr/share/vkd3d-proton --bindir x$bits --libdir x$bits \
            -D enable_tests=false -D enable_extras=false --strip
        ninja -C "build$bits"
    done
}

package() {
    DESTDIR="$pkgdir" ninja -C build64 install
    DESTDIR="$pkgdir" ninja -C build86 install
    find "$pkgdir/usr/share/vkd3d-proton" -name '*.a' -delete
    install -Dm644 vkd3d-proton-$pkgver/LICENSE "$pkgdir/usr/share/licenses/vkd3d-proton/LICENSE"
}
