# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kwallet
_lockname=kf6-kwallet
pkgver=6.18.0
pkgrel=1
pkgdesc="Desktop encrypted wallet and Secret Service"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-or-later LGPL-3.0-or-later)
depends=(qt6-base kconfig kcoreaddons ki18n kwindowsystem kcolorscheme kdbusaddons knotifications kwidgetsaddons kcrash qca-qt6 libsecret libgcrypt)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kwallet-$pkgver.tar.xz")
sha256sums=('c8630e1b280b9aee44f3367302fce381370a611557f1941908b9286e3891d163')

build() {
    cmake -S kwallet-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kwallet-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
