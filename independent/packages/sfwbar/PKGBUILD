# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=sfwbar
pkgver=1.0_beta16
pkgrel=1
pkgdesc="Panel for Wayland: taskbar, app menu, clock, volume and network"
arch=(x86_64)
url="https://github.com/LBCrion/sfwbar"
license=(GPL-3.0-or-later)
depends=(glibc gtk3 gtk-layer-shell json-c)
source=("https://github.com/LBCrion/sfwbar/archive/v$pkgver/sfwbar-$pkgver.tar.gz")
sha256sums=('238d6394650dfdfc2f36374ec25702bbef57e2cff1d9a149ecb9a52f887c3cdf')

build() {
    # modules that need libraries Yūrei doesn't have yet are left out; C17,
    # since GCC 15's default C23 reads its "()" declarations differently
    meson setup sfwbar-$pkgver build --prefix=/usr --buildtype=release --wrap-mode=nofallback \
        -D c_std=gnu17 \
        -D mpd=disabled -D pulse=disabled -D bluez=disabled -D iwd=enabled -D alsa=enabled \
        -D network=enabled -D idleinhibit=enabled -D xkb=enabled -D nm=disabled \
        -D bsdctl=disabled
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
