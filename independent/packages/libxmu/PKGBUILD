# Maintainer: Yurei Linux project
pkgname=libxmu
pkgver=1.3.1
pkgrel=1
pkgdesc="X11 remote session support: libxmu"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(libxt libxext libx11)
source=("https://www.x.org/releases/individual/lib/libXmu-1.3.1.tar.xz")
sha256sums=('81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4')
build() {
    cd libXmu-$pkgver
    ./configure --prefix=/usr --disable-static --disable-docs --disable-devel-docs
    make
}
package() {
    cd libXmu-$pkgver
    make DESTDIR="$pkgdir" install
}
