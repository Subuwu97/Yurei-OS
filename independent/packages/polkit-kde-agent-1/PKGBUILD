# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=polkit-kde-agent-1
_lockname=plasma-polkit-kde-agent-1
pkgver=6.4.5
pkgrel=1
pkgdesc="Desktop authorization password prompt"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later)
depends=(qt6-base qt6-declarative ki18n kwindowsystem knotifications kdbusaddons kcoreaddons kcrash polkit-qt6)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/polkit-kde-agent-1-$pkgver.tar.xz")
sha256sums=('5b5d771660f5209295a65afdcb3e117c1cc9cd7c1893d0c9b68ad0c531308301')

build() {
    cmake -S polkit-kde-agent-1-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a polkit-kde-agent-1-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
