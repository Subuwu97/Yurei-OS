# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 4; docs/INDEPENDENT.md). Sound Open Firmware:
# the firmware and topology files Intel's (and some AMD) laptop sound DSPs
# load, as the SOF project releases them. The source address and sum are
# the ones in independent/bootstrap/sources.lock; check-recipes.py keeps
# them the same.
pkgname=sof-firmware
pkgver=2025.12.2
pkgrel=2
pkgdesc="Sound Open Firmware: laptop speakers and microphones on Intel's sound DSP"
arch=(any)
url="https://www.sofproject.org/"
license=(BSD-3-Clause)
options=(!strip)
source=("https://github.com/thesofproject/sof-bin/releases/download/v$pkgver/sof-bin-$pkgver.tar.gz")
sha256sums=('533f63e3a6d94c09ce05a782657b675fa683ff20787c0979226cf563ec79f517')

package() {
    cd sof-bin-$pkgver
    install -d "$pkgdir/usr/lib/firmware/intel"
    # what install.sh does (with rsync, which Yūrei doesn't have): the sof*
    # folders, their version links kept, into the firmware folder
    cp -a --no-preserve=ownership sof* "$pkgdir/usr/lib/firmware/intel/"
    [[ -n $(ls "$pkgdir/usr/lib/firmware/intel") ]]
    install -Dm644 LICENCE.Intel "$pkgdir/usr/share/licenses/sof-firmware/LICENCE.Intel"
}
