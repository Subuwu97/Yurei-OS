<?xml version="1.0"?>
<!-- Yūrei's labwc settings: labwc's own defaults, with Super+Enter opening
     Konsole (with Foot as a fallback) and Super+E opening Dolphin. -->
<labwc_config>
  <theme>
    <cornerRadius>6</cornerRadius>
    <font place=""><name>DejaVu Sans</name><size>10</size></font>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="yurei-terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="yurei-files" /></keybind>
  </keyboard>
</labwc_config>
