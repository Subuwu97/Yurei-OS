# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3): the yurei-desktop command, which starts the
# graphical session: labwc with a terminal (or one terminal in cage).
pkgname=yurei-desktop
pkgver=0.5
pkgrel=4
pkgdesc="Starts Yūrei's graphical session from the console"
arch=(any)
url="https://github.com/Subuwu97/Yurei-OS"
license=(GPL-3.0-or-later)
depends=(labwc cage foot sfwbar pipewire wireplumber adwaita-icon-theme polkit
         dbus thunar xwayland)

package() {
    install -Dm755 "$startdir/yurei-desktop" "$pkgdir/usr/bin/yurei-desktop"
    install -Dm644 -t "$pkgdir/etc/xdg/labwc" "$startdir/labwc/rc.xml" "$startdir/labwc/menu.xml" \
        "$startdir/labwc/autostart" "$startdir/labwc/environment"
    install -Dm644 /dev/stdin "$pkgdir/usr/share/wayland-sessions/labwc.desktop" <<'SESSION'
[Desktop Entry]
Name=Yurei labwc (fallback)
Comment=Lightweight Wayland fallback desktop
Exec=/usr/bin/yurei-desktop --labwc
TryExec=/usr/bin/labwc
Type=Application
DesktopNames=labwc
SESSION
    install -Dm644 "$startdir/profile.sh" "$pkgdir/etc/profile.d/yurei-desktop.sh"
}
