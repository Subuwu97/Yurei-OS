# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3): the yurei-desktop command, which starts the
# first graphical session (a terminal in the cage compositor).
pkgname=yurei-desktop
pkgver=0.1
pkgrel=1
pkgdesc="Starts Yūrei's graphical session from the console"
arch=(any)
url="https://github.com/Subuwu97/Yurei-OS"
license=(GPL-3.0-or-later)
depends=(cage foot)

package() {
    install -Dm755 "$startdir/yurei-desktop" "$pkgdir/usr/bin/yurei-desktop"
}
