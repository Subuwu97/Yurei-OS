# Maintainer: Yurei Linux project
pkgname=kfilemetadata
pkgver=6.18.0
pkgrel=1
pkgdesc="Yurei KDE desktop: kfilemetadata"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only LicenseRef-KDE-Accepted-LGPL)
depends=(qt6-base karchive kcoreaddons kconfig ki18n kcodecs attr ffmpeg)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kfilemetadata-$pkgver.tar.xz")
sha256sums=('05c4b0955885b46fed6dc23998760fdae59599a960159ec44f779d7498a08834')

build() {
    cmake -S kfilemetadata-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kfilemetadata-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
