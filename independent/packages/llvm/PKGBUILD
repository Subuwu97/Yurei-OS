# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=llvm
_lockname=llvm
pkgver=20.1.8
pkgrel=1
pkgdesc="LLVM compiler toolkit and Clang: AMD's and the software OpenGL drivers compile shaders with it"
arch=(x86_64)
url="https://llvm.org/"
license=(Apache-2.0 WITH LLVM-exception)
depends=(glibc gcc-libs zlib zstd libffi ncurses)
options=(!lto)
source=("https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver/llvm-project-$pkgver.src.tar.xz")
sha256sums=('6898f963c8e938981e6c4a302e83ec5beb4630147c7311183cf61069af16333d')

build() {
    # x86-64 and AMD GPUs only; one shared libLLVM and libclang-cpp, which
    # keeps the build and the package small
    cmake -S llvm-project-$pkgver.src/llvm -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DLLVM_ENABLE_PROJECTS=clang -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
        -DLLVM_HOST_TRIPLE=x86_64-pc-linux-gnu \
        -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON -DCLANG_LINK_CLANG_DYLIB=ON \
        -DLLVM_ENABLE_RTTI=ON -DLLVM_ENABLE_FFI=ON -DLLVM_ENABLE_ZSTD=ON \
        -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_INSTALL_UTILS=ON -DLLVM_PARALLEL_LINK_JOBS=2 \
        -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_DOCS=OFF -DCLANG_INCLUDE_TESTS=OFF -DCLANG_DEFAULT_PIE_ON_LINUX=ON
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
