# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kded
_lockname=kf6-kded
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE background service manager"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later)
depends=(qt6-base kconfig kcoreaddons kcrash kdbusaddons kservice)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kded-$pkgver.tar.xz")
sha256sums=('c90e3ee6bf991f320ac428b2c126afbfe1130a74eee6724058105883072e5882')

build() {
    cmake -S kded-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kded-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
