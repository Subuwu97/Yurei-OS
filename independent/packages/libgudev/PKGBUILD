# Maintainer: Yurei Linux project
pkgname=libgudev
_lockname=libgudev
pkgver=238
pkgrel=1
pkgdesc="libgudev: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(LGPL-2.1-or-later GPL-2.0-or-later)
depends=(glib systemd)
source=("https://download.gnome.org/sources/libgudev/$pkgver/libgudev-$pkgver.tar.xz")
sha256sums=('61266ab1afc9d73dbc60a8b2af73e99d2fdff47d99544d085760e4fa667b5dd1')

build() {
    meson setup libgudev-$pkgver build --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release --wrap-mode=nofallback -Dtests=disabled -Dintrospection=disabled -Dvapi=disabled -Dgtk_doc=false
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm644 "$srcdir/libgudev-$pkgver/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
