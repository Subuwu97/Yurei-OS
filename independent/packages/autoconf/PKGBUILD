# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=autoconf
pkgver=2.72
pkgrel=1
pkgdesc="A GNU tool for automatically configuring source code"
arch=(x86_64)
url="https://www.gnu.org/software/autoconf/"
license=(GPL-3.0-or-later)
depends=(perl m4 bash)
source=("https://ftp.gnu.org/gnu/autoconf/autoconf-$pkgver.tar.xz")
sha256sums=('ba885c1319578d6c94d46e9b0dceb4014caafe2490e437a0dbca3f270a223f5a')

build() {
    cd autoconf-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd autoconf-$pkgver
    make DESTDIR="$pkgdir" install
}
