# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libxext
pkgver=1.3.6
pkgrel=1
pkgdesc="Common X11 extensions library"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(libx11)
source=("https://www.x.org/releases/individual/lib/libXext-$pkgver.tar.xz")
sha256sums=('edb59fa23994e405fdc5b400afdf5820ae6160b94f35e3dc3da4457a16e89753')

build() {
    cd libXext-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
        --disable-specs
    make
}

package() {
    cd libXext-$pkgver
    make DESTDIR="$pkgdir" install
}
