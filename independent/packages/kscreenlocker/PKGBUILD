# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kscreenlocker
_lockname=plasma-kscreenlocker
pkgver=6.4.5
pkgrel=1
pkgdesc="Plasma screen locking and authentication"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative kcrash kcmutils kio kglobalaccel ki18n kidletime knotifications solid kwindowsystem kxmlgui ksvg libplasma libx11 libxcb xcb-util-keysyms wayland layer-shell-qt libkscreen linux-pam systemd)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/kscreenlocker-$pkgver.tar.xz")
sha256sums=('fac4f9d53d63cb9b06e90feb82c28f471971d15defd4a068bb1e7d2886b7090d')

build() {
    cmake -S kscreenlocker-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 /dev/stdin "$pkgdir/etc/pam.d/kde" <<'PAM'
auth include system-auth
account include system-auth
password include system-auth
session include system-auth
PAM
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kscreenlocker-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
