# Maintainer: Yurei Linux project
pkgname=flite
pkgver=2.2
pkgrel=1
pkgdesc="Small speech synthesis engine with bundled voices"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(LicenseRef-Flite)
depends=(glibc alsa-lib)
source=("flite-$pkgver.tar.gz::https://github.com/festvox/flite/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ab1555fe5adc3f99f1d4a1a0eb1596d329fd6d74f1464a0097c81f53c0cf9e5c')

build() {
    cd flite-$pkgver
    ./configure --prefix=/usr --libdir=/usr/lib --enable-shared --with-audio=alsa
    make -j1
}

package() {
    cd flite-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
