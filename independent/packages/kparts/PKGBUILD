# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kparts
_lockname=kf6-kparts
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE document component framework"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons ki18n kio kjobwidgets kservice kwidgetsaddons kxmlgui)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kparts-$pkgver.tar.xz")
sha256sums=('846e522e6aff2a219064a52e9baeefdfbcbea71dadb1810b9c58cb9c41821604')

build() {
    cmake -S kparts-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kparts-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
