# Maintainer: Yurei Linux project
pkgname=libnl
pkgver=3.11.0
pkgrel=1
pkgdesc="Netlink socket libraries for Plasma system monitoring"
arch=(x86_64)
url="https://github.com/thom311/libnl"
license=(LGPL-2.1-only)
depends=(glibc)
source=("https://github.com/thom311/libnl/releases/download/libnl3_11_0/libnl-$pkgver.tar.gz")
sha256sums=('2a56e1edefa3e68a7c00879496736fdbf62fc94ed3232c0baba127ecfa76874d')

build() {
    cd libnl-$pkgver
    ./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --disable-static --disable-cli
    make
}

package() {
    cd libnl-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
