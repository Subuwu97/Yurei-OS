# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=krunner
_lockname=kf6-krunner
pkgver=6.18.0
pkgrel=1
pkgdesc="Plasma desktop search framework"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause CC-BY-SA-4.0 CC0-1.0 LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons ki18n kitemmodels kwindowsystem)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/krunner-$pkgver.tar.xz")
sha256sums=('69a20b4e554d8763ef4a52978e46056b598efb8ec584ac7be5bf06ca318db51c')

build() {
    cmake -S krunner-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a krunner-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
