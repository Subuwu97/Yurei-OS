# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-attica); check-recipes.py keeps them the same.
pkgname=attica
_lockname=kf6-attica
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: the Open Collaboration Services API (KDE Store)"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/attica-$pkgver.tar.xz")
sha256sums=('eb2b2be33cc83512c77af2559fcaf7fc58ad191abb82cf40b17b2e9e8400e336')

build() {
    cmake -S attica-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
