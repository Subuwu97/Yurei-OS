# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=ktextwidgets
_lockname=kf6-ktextwidgets
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE text widgets with speech support"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-or-later LGPL-3.0-only)
depends=(qt6-base qt6-speech kcompletion kconfig ki18n kwidgetsaddons sonnet)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/ktextwidgets-$pkgver.tar.xz")
sha256sums=('9afb136806e8b95c34211e1dae66e4cf14d7aac2ab244d5264caac4e823d8edf')

build() {
    cmake -S ktextwidgets-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a ktextwidgets-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
