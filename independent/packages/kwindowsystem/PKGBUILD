# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kwindowsystem); check-recipes.py keeps them the same.
pkgname=kwindowsystem
_lockname=kf6-kwindowsystem
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: windows on X11 and Wayland"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-wayland qt6-declarative libx11 libxcb xcb-util-keysyms libxfixes)
makedepends=(extra-cmake-modules qt6-tools plasma-wayland-protocols wayland-protocols)
source=("https://download.kde.org/stable/frameworks/6.18/kwindowsystem-$pkgver.tar.xz")
sha256sums=('a0a046039a11baebacd96d836e5765b981426f60d2cea9ff9a99ba8dbe56178e')

build() {
    cmake -S kwindowsystem-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
