# Maintainer: Yūrei Linux project
pkgname=libcanberra
pkgver=0.30
pkgrel=1
pkgdesc="Desktop notification sounds through PulseAudio and ALSA"
arch=(x86_64)
url="https://0pointer.de/lennart/projects/libcanberra/libcanberra-$pkgver.tar.xz"
license=(LGPL-2.1-or-later)
depends=(glibc libtool libvorbis libpulse alsa-lib)
source=("https://0pointer.de/lennart/projects/libcanberra/libcanberra-$pkgver.tar.xz")
sha256sums=('c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72')

build() {
    cd libcanberra-$pkgver
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static --enable-pulse --enable-alsa --disable-oss --disable-udev --disable-gstreamer --disable-gtk --disable-gtk3 --disable-tdb --disable-lynx --with-builtin=dso
    make
}

package() {
    cd libcanberra-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 LGPL "$pkgdir/usr/share/licenses/$pkgname/LGPL"
}
