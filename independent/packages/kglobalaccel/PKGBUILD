# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kglobalaccel
_lockname=kf6-kglobalaccel
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kglobalaccel"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-or-later)
depends=(qt6-base libx11)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kglobalaccel-$pkgver.tar.xz")
sha256sums=('cb9a7b0ee933656207958fb295bf14fbfbc828d5d968f601fd28ad6877fdb438')

build() {
    cmake -S kglobalaccel-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kglobalaccel-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
