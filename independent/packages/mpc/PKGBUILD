# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=mpc
pkgver=1.3.1
pkgrel=1
pkgdesc="Library for the arithmetic of complex numbers with arbitrarily high precision"
arch=(x86_64)
url="https://www.multiprecision.org/mpc/"
license=(LGPL-3.0-or-later)
depends=(mpfr gmp glibc)
source=("https://ftp.gnu.org/gnu/mpc/mpc-$pkgver.tar.gz")
sha256sums=('ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8')

build() {
    cd mpc-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd mpc-$pkgver
    make DESTDIR="$pkgdir" install
}
