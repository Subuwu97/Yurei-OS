# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libxshmfence
pkgver=1.3.3
pkgrel=1
pkgdesc="Shared memory fences for X and Mesa"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(glibc)
source=("https://www.x.org/releases/individual/lib/libxshmfence-$pkgver.tar.xz")
sha256sums=('d4a4df096aba96fea02c029ee3a44e11a47eb7f7213c1a729be83e85ec3fde10')

build() {
    cd libxshmfence-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
    make
}

package() {
    cd libxshmfence-$pkgver
    make DESTDIR="$pkgdir" install
}
