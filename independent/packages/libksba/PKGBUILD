# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=libksba
pkgver=1.6.7
pkgrel=1
pkgdesc="Library for working with X.509 certificates, CMS data and related objects"
arch=(x86_64)
url="https://www.gnupg.org/"
license=(LGPL-3.0-or-later GPL-2.0-or-later)
depends=(glibc libgpg-error)
source=("https://www.gnupg.org/ftp/gcrypt/libksba/libksba-$pkgver.tar.bz2")
sha256sums=('cf72510b8ebb4eb6693eef765749d83677a03c79291a311040a5bfd79baab763')

build() {
    cd libksba-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd libksba-$pkgver
    make DESTDIR="$pkgdir" install
}
