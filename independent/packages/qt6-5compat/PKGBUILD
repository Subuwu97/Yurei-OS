# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=qt6-5compat
pkgver=6.9.3
pkgrel=1
pkgdesc="Qt 6 compatibility module (graphical effects Plasma's QML uses)"
arch=(x86_64)
url="https://www.qt.io/"
license=(LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only)
depends=(qt6-base qt6-declarative qt6-shadertools)
options=(!lto)
source=("https://download.qt.io/official_releases/qt/6.9/$pkgver/submodules/qt5compat-everywhere-src-$pkgver.tar.xz")
sha256sums=('PIN')

build() {
    cmake -S qt5compat-everywhere-src-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DINSTALL_PUBLICBINDIR=usr/bin -DCMAKE_BUILD_TYPE=Release \
        -DQT_BUILD_TESTS=OFF -DQT_BUILD_EXAMPLES=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # the tools people run also in /usr/bin, as Qt lists them
    if [[ -f "$srcdir/build/user_facing_tool_links.txt" ]]; then
        cd "$pkgdir"
        mkdir -p usr/bin
        while read -r target link; do
            ln -s "/$target" "$link"
        done < "$srcdir/build/user_facing_tool_links.txt"
    fi
}
