# Maintainer: Yurei Linux project
pkgname=xorg-server
pkgver=21.1.25
pkgrel=4
pkgdesc="Hyper-V enhanced session support: xorg-server"
arch=(x86_64)
url="https://www.x.org/releases/individual/xserver"
license=(MIT)
depends=(libpciaccess pixman libxfont2 libxkbfile libxcvt libxau libxdmcp systemd mesa libepoxy libdrm openssl xkeyboard-config xkbcomp)
source=("xorg-server-21.1.25.tar.xz::https://www.x.org/releases/individual/xserver/xorg-server-21.1.25.tar.xz")
sha256sums=('6ad4e3c7b59a309b32c92e5c15ce1267110f9e13f1ac78da62361a628da1a0eb')

build() {
    # Xorg modules also include PCI SDK headers; keep PCI, platform devices
    # and logind support enabled together with their required library.
    pkg-config --exists pciaccess libudev dbus-1
    meson setup xorg-server-$pkgver build --prefix=/usr --libdir=lib \
        --buildtype=release --wrap-mode=nofallback \
        -Dxorg=true -Dxnest=false -Dxvfb=false -Dxephyr=false -Dxwin=false -Dxquartz=false \
        -Dglamor=true -Dglx=true -Ddri1=false -Ddri2=true -Ddri3=true \
        -Dpciaccess=true -Dint10=false -Dvgahw=false -Dudev=true -Dudev_kms=true \
        -Dsystemd_logind=true -Dsecure-rpc=false -Dxselinux=false \
        -Ddocs=false -Ddevel-docs=false -Ddocs-pdf=false \
        -Ddefault_font_path=/usr/share/fonts -Dxkb_dir=/usr/share/X11/xkb -Dxkb_bin_dir=/usr/bin
    meson compile -C build
}
package() {
    DESTDIR="$pkgdir" meson install -C build
    # Xwayland already owns these shared X server documents in Yurei.
    # Keep one owner so installing both servers is a valid transaction.
    rm -f "$pkgdir/usr/lib/xorg/protocol.txt" \
        "$pkgdir/usr/share/man/man1/Xserver.1" \
        "$pkgdir/usr/share/man/man1/Xserver.1.gz"
}
