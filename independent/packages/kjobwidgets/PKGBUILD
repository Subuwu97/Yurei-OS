# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kjobwidgets
_lockname=kf6-kjobwidgets
pkgver=6.18.0
pkgrel=1
pkgdesc="Widgets for tracking desktop jobs"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later LGPL-3.0-only)
depends=(qt6-base kcoreaddons kwidgetsaddons knotifications)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kjobwidgets-$pkgver.tar.xz")
sha256sums=('e739ff254c4fa34c0de00aa2d9deee138135d99cd0b46ef5db253c18c02bce98')

build() {
    cmake -S kjobwidgets-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kjobwidgets-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
