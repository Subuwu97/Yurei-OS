# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kcompletion
_lockname=kf6-kcompletion
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kcompletion"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 LGPL-2.0-or-later LGPL-2.1-or-later)
depends=(qt6-base kcodecs kconfig kwidgetsaddons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kcompletion-$pkgver.tar.xz")
sha256sums=('6d06881ff2ece4c29df5c3cbe3700cb5e3425064686a667e84f06f2a5732a1c5')

build() {
    cmake -S kcompletion-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kcompletion-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
