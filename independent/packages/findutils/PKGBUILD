# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=findutils
pkgver=4.10.0
pkgrel=1
pkgdesc="GNU utilities to locate files"
arch=(x86_64)
url="https://www.gnu.org/software/findutils/"
license=(GPL-3.0-or-later)
depends=(glibc)
source=("https://ftp.gnu.org/gnu/findutils/findutils-$pkgver.tar.xz")
sha256sums=('1387e0b67ff247d2abde998f90dfbf70c1491391a59ddfecb8ae698789f0a4f5')

build() {
    cd findutils-$pkgver
    ./configure --prefix=/usr --localstatedir=/var/lib/locate
    make
}

package() {
    cd findutils-$pkgver
    make DESTDIR="$pkgdir" install
}
