# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kdbusaddons); check-recipes.py keeps them the same.
pkgname=kdbusaddons
_lockname=kf6-kdbusaddons
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: D-Bus additions to Qt"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kdbusaddons-$pkgver.tar.xz")
sha256sums=('dce95cd146e18b400c4df31ea8c9bbba8f919e329a52dc1a19635184ac85e49a')

build() {
    cmake -S kdbusaddons-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
