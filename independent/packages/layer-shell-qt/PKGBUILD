# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=layer-shell-qt
_lockname=plasma-layer-shell-qt
pkgver=6.4.5
pkgrel=1
pkgdesc="Qt Wayland layer-shell integration"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-3-Clause CC0-1.0 LGPL-2.1-only LGPL-3.0-only LGPL-3.0-or-later MIT)
depends=(qt6-base qt6-declarative qt6-wayland wayland wayland-protocols libxkbcommon)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/layer-shell-qt-$pkgver.tar.xz")
sha256sums=('ef6baae22114f038af89029f3f0075ee29c3b91fd49100828c4c3a32e1496e95')

build() {
    cmake -S layer-shell-qt-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a layer-shell-qt-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
