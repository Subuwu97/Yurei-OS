# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=ncurses
pkgver=6.5
pkgrel=1
pkgdesc="System V Release 4.0 curses emulation library"
arch=(x86_64)
url="https://invisible-island.net/ncurses/"
license=(MIT-open-group)
depends=(glibc)
source=("https://ftp.gnu.org/gnu/ncurses/ncurses-$pkgver.tar.gz")
sha256sums=('136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6')

build() {
    cd ncurses-$pkgver
    # GCC 15 defaults to C23, where bool is a keyword; ncurses 6.5 predates that
    CC="gcc -std=gnu17" ./configure --prefix=/usr --mandir=/usr/share/man --with-shared \
        --without-debug --without-normal --with-cxx-shared --enable-pc-files \
        --with-pkg-config-libdir=/usr/lib/pkgconfig
    make
}

package() {
    cd ncurses-$pkgver
    make DESTDIR="$pkgdir" install
    # the wide-character library is the only one; say so in the header
    sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$pkgdir/usr/include/curses.h"
    local lib
    for lib in ncurses form panel menu; do
        ln -sf lib${lib}w.so "$pkgdir/usr/lib/lib${lib}.so"
        ln -sf ${lib}w.pc "$pkgdir/usr/lib/pkgconfig/${lib}.pc"
    done
    ln -sf libncursesw.so "$pkgdir/usr/lib/libcurses.so"
}
