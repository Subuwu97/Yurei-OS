# Maintainer: Yurei Linux project
pkgname=xdg-desktop-portal-kde
pkgver=6.4.5
pkgrel=2
pkgdesc="xdg-desktop-portal-kde: application store and sandboxed desktop support"
arch=(x86_64)
url="https://download.kde.org/stable/plasma/6.4.5"
license=(LGPL-2.1-or-later)
depends=(xdg-desktop-portal qt6-base qt6-declarative qt6-wayland kcoreaddons kconfig ki18n kguiaddons kglobalaccel kio kirigami knotifications kservice kwidgetsaddons kwindowsystem kiconthemes kstatusnotifieritem kcrash kwayland plasma-wayland-protocols libxkbcommon)
_lockname=plasma-xdg-desktop-portal-kde
source=("https://download.kde.org/stable/plasma/6.4.5/xdg-desktop-portal-kde-6.4.5.tar.xz")
sha256sums=('9fe04f0482bbf326088369c035d7b6f403db0c06aea5934442a7788799edcee2')

build() {
    cmake -S xdg-desktop-portal-kde-6.4.5 -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF 
    cmake --build build
}
package() {
    DESTDIR="$pkgdir" cmake --install build
}
