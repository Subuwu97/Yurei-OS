# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=flex
pkgver=2.6.4
pkgrel=1
pkgdesc="A tool for generating text-scanning programs"
arch=(x86_64)
url="https://github.com/westes/flex"
license=(BSD-2-Clause)
depends=(glibc m4)
source=("https://github.com/westes/flex/releases/download/v$pkgver/flex-$pkgver.tar.gz")
sha256sums=('e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995')

build() {
    cd flex-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd flex-$pkgver
    make DESTDIR="$pkgdir" install
    ln -s flex "$pkgdir/usr/bin/lex"
}
