# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=bison
pkgver=3.8.2
pkgrel=1
pkgdesc="The GNU general-purpose parser generator"
arch=(x86_64)
url="https://www.gnu.org/software/bison/"
license=(GPL-3.0-or-later)
depends=(glibc m4)
source=("https://ftp.gnu.org/gnu/bison/bison-$pkgver.tar.xz")
sha256sums=('9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2')

build() {
    cd bison-$pkgver
    ./configure --prefix=/usr
    make
}

package() {
    cd bison-$pkgver
    make DESTDIR="$pkgdir" install
}
