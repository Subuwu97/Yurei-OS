# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kpackage
_lockname=kf6-kpackage
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kpackage"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-or-later LGPL-2.0-or-later)
depends=(qt6-base karchive ki18n kcoreaddons)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kpackage-$pkgver.tar.xz")
sha256sums=('1bc2e43bf2239dc20e836b70877631e103057fb14a9467290c76fa45ff02870e')

build() {
    cmake -S kpackage-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kpackage-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
