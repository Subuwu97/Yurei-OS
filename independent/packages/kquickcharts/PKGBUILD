# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kquickcharts
_lockname=kf6-kquickcharts
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kquickcharts"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause CC0-1.0 LGPL-2.1-only LGPL-3.0-only MIT)
depends=(qt6-base qt6-declarative qt6-shadertools)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kquickcharts-$pkgver.tar.xz")
sha256sums=('941ead378d02e0581b706639c7cf474339818f6cd48d918646782f71bc7f74cb')

build() {
    cmake -S kquickcharts-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kquickcharts-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
