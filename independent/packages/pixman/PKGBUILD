# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=pixman
pkgver=0.44.2
pkgrel=1
pkgdesc="Low-level pixel drawing, used by compositors and Cairo"
arch=(x86_64)
url="https://pixman.org/"
license=(MIT)
depends=(glibc)
source=("https://cairographics.org/releases/pixman-$pkgver.tar.gz")
sha256sums=('6349061ce1a338ab6952b92194d1b0377472244208d47ff25bef86fc71973466')

build() {
    meson setup pixman-$pkgver build --prefix=/usr --buildtype=release \
        -D tests=disabled -D demos=disabled -D gtk=disabled -D libpng=disabled
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
