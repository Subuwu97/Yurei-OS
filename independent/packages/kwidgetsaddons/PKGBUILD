# Maintainer: Yurei Linux project
# KDE Frameworks 6.18 foundation, built from KDE's verified source archive.
pkgname=kwidgetsaddons
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE additional Qt widgets"
arch=(x86_64)
url="https://invent.kde.org/frameworks/kwidgetsaddons"
license=(BSD-2-Clause CC0-1.0 GPL-2.0-or-later LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-2.1-or-later LGPL-3.0-only LGPL-3.0-or-later LicenseRef-KDE-Accepted-LGPL)
depends=(qt6-base gcc-libs)
makedepends=(cmake ninja extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kwidgetsaddons-$pkgver.tar.xz")
sha256sums=('0c2fb00744ffd9ecb7531ee5a79c1db4b406753f250565122f3add93cf200afb')

build() {
    cmake -S kwidgetsaddons-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        -DBUILD_QCH=OFF -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DBUILD_PYTHON_BINDINGS=OFF -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" kwidgetsaddons-$pkgver/LICENSES/*
}
