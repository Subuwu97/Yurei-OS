# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kwidgetsaddons); check-recipes.py keeps them the same.
pkgname=kwidgetsaddons
_lockname=kf6-kwidgetsaddons
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: widgets"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kwidgetsaddons-$pkgver.tar.xz")
sha256sums=('0c2fb00744ffd9ecb7531ee5a79c1db4b406753f250565122f3add93cf200afb')

build() {
    cmake -S kwidgetsaddons-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
