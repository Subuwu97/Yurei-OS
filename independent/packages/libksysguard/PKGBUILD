# Maintainer: Yurei Linux project
pkgname=libksysguard
_lockname=plasma-libksysguard
pkgver=6.4.5
pkgrel=1
pkgdesc="Plasma process and system monitoring libraries"
arch=(x86_64)
url="https://kde.org/"
license=(BSD-2-Clause BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative kcoreaddons kconfig ki18n kauth kservice kpackage knewstuff solid zlib libcap libdrm)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/libksysguard-$pkgver.tar.xz")
sha256sums=('c7cf8cd2f0a1e519201dc62889f1135967a850f932c252fd26ea3d88c6564a0f')

build() {
    cmake -S libksysguard-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_EXAMPLES=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a libksysguard-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
