# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kplotting); check-recipes.py keeps them the same.
pkgname=kplotting
_lockname=kf6-kplotting
pkgver=6.18.0
pkgrel=2
pkgdesc="KDE Frameworks: plots"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kplotting-$pkgver.tar.xz")
sha256sums=('c9fdb99fd1c75f588e2f15ef84333feadf327a878c24324e44493d03e593ebc9')

build() {
    cmake -S kplotting-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
