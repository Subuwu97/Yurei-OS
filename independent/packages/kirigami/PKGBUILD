# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kirigami); check-recipes.py keeps them the same.
pkgname=kirigami
_lockname=kf6-kirigami
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: Kirigami, the QML toolkit Plasma's settings and apps use"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-declarative qt6-svg qt6-shadertools)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kirigami-$pkgver.tar.xz")
sha256sums=('e0574bf5f530a7cd98e0342498681f4374beff108e74262063b105e1c977f866')

build() {
    cmake -S kirigami-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
