# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kglobalacceld
_lockname=plasma-kglobalacceld
pkgver=6.4.5
pkgrel=1
pkgdesc="Desktop global keyboard shortcut daemon"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons kcrash kdbusaddons kwindowsystem kglobalaccel kservice kio kjobwidgets libxcb xcb-util-keysyms)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.4.5/kglobalacceld-$pkgver.tar.xz")
sha256sums=('a712d1f7a86960292feb6979fe2c92f2e7d5cfbcd107f4efe3979e1a4c32cd73')

build() {
    cmake -S kglobalacceld-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kglobalacceld-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
