# Maintainer: Yurei Linux project
pkgname=libsecret
pkgver=0.21.7
pkgrel=1
pkgdesc="Secret Service client library"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(LGPL-2.1-or-later)
depends=(glibc glib libgcrypt)
source=("https://download.gnome.org/sources/libsecret/0.21/libsecret-$pkgver.tar.xz")
sha256sums=('6b452e4750590a2b5617adc40026f28d2f4903de15f1250e1d1c40bfd68ed55e')

build() {
    meson setup libsecret-$pkgver build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback \
        -Dcrypto=libgcrypt -Dintrospection=false -Dvapi=false -Dgtk_doc=false -Dmanpage=false -Dpam=false
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm644 libsecret-$pkgver/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
