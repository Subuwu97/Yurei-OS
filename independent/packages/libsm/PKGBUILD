# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=libsm
pkgver=1.2.5
pkgrel=1
pkgdesc="X11 session management library"
arch=(x86_64)
url="https://www.x.org/"
license=(MIT)
depends=(libice util-linux)
source=("https://www.x.org/releases/individual/lib/libSM-$pkgver.tar.xz")
sha256sums=('2af9e12da5ef670dc3a7bce1895c9c0f1bfb0cb9e64e8db40fcc33f883bd20bc')

build() {
    cd libSM-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
        --disable-docs
    make
}

package() {
    cd libSM-$pkgver
    make DESTDIR="$pkgdir" install
}
