# Maintainer: Yurei Linux project
pkgname=plasma-nm
_lockname=plasma-plasma-nm
pkgver=6.4.5
pkgrel=1
pkgdesc="plasma-nm: independent Plasma desktop support"
arch=(x86_64)
url="https://github.com/Subuwu97/Yurei-OS"
license=(BSD-3-Clause CC0-1.0 GPL-2.0-only GPL-2.0-or-later GPL-3.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base qt6-declarative kcolorscheme kcompletion kcoreaddons kdbusaddons kio ki18n networkmanager-qt knotifications kservice solid kwallet kwidgetsaddons kwindowsystem kcmutils ksvg modemmanager-qt libplasma kirigami qca-qt6 prison qcoro)
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-nm-$pkgver.tar.xz")
sha256sums=('4a7d2296688e9597eede444de6fe6548131ed69136a6e1c4aadefa0f4a015d16')

build() {
    cmake -S plasma-nm-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DBUILD_OPENCONNECT=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a plasma-nm-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
