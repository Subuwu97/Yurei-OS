# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=libgpg-error
pkgver=1.55
pkgrel=1
pkgdesc="Support library for libgcrypt"
arch=(x86_64)
url="https://www.gnupg.org/"
license=(LGPL-2.1-or-later)
depends=(glibc)
source=("https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-$pkgver.tar.bz2")
sha256sums=('95b178148863f07d45df0cea67e880a79b9ef71f5d230baddc0071128516ef78')

build() {
    cd libgpg-error-$pkgver
    ./configure --prefix=/usr --disable-static
    make
}

package() {
    cd libgpg-error-$pkgver
    make DESTDIR="$pkgdir" install
}
