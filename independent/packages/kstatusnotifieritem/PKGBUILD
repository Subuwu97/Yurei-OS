# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kstatusnotifieritem
_lockname=kf6-kstatusnotifieritem
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kstatusnotifieritem"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-or-later)
depends=(qt6-base kwindowsystem libx11)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kstatusnotifieritem-$pkgver.tar.xz")
sha256sums=('d78aa20e1858f700478eecedb49714160d5e04b4a0d177bca4355aa1a0f7d730')

build() {
    cmake -S kstatusnotifieritem-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kstatusnotifieritem-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
