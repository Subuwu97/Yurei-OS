# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 3, the desktop; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock;
# check-recipes.py keeps them the same.
pkgname=mesa
pkgver=25.1.5
pkgrel=2
pkgdesc="Graphics drivers: OpenGL and Vulkan for Intel (Arc too), AMD and NVIDIA (nouveau)"
arch=(x86_64)
url="https://www.mesa3d.org/"
license=(MIT)
depends=(glibc gcc-libs libdrm wayland expat zlib zstd libelf llvm systemd spirv-tools
         libx11 libxcb libxext libxfixes libxrandr libxshmfence libxxf86vm xcb-util-keysyms)
source=("https://archive.mesa3d.org/mesa-$pkgver.tar.xz")
sha256sums=('3c4f6b10ff6ee950d0ec6ea733cc6e6d34c569454e3d39a9b276de9115a3b363')

build() {
    # Wayland and X11 (GLX, for X11 programs through Xwayland: Wine, games).
    #   OpenGL: iris and crocus (Intel, Arc included), radeonsi (AMD),
    #           nouveau (NVIDIA), llvmpipe (software), virgl (virtual machines)
    #   Vulkan: anv (Intel, Arc included), radv (AMD)
    # NVK (NVIDIA Vulkan) needs Rust, which Yūrei doesn't have yet.
    meson setup mesa-$pkgver build --prefix=/usr --buildtype=release \
        -D platforms=x11,wayland -D glx=dri -D egl=enabled -D gbm=enabled \
        -D gles1=disabled -D gles2=enabled -D glvnd=disabled \
        -D gallium-drivers=iris,crocus,radeonsi,nouveau,llvmpipe,softpipe,virgl \
        -D vulkan-drivers=intel,amd -D vulkan-layers=device-select \
        -D llvm=enabled -D shared-llvm=enabled -D intel-rt=disabled \
        -D gallium-va=disabled -D gallium-vdpau=disabled -D gallium-rusticl=false \
        -D microsoft-clc=disabled -D valgrind=disabled -D libunwind=disabled \
        -D lmsensors=disabled -D build-tests=false -D zstd=enabled -D expat=enabled
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}
