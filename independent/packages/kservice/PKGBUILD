# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kservice
_lockname=kf6-kservice
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kservice"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons ki18n)
makedepends=(extra-cmake-modules qt6-tools bison flex)
source=("https://download.kde.org/stable/frameworks/6.18/kservice-$pkgver.tar.xz")
sha256sums=('d08aca74dcc54da29dd2b7bc404ed9e6ec688acc77839b4b8fbc372b5ea350b8')

build() {
    cmake -S kservice-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF -DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kservice-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
