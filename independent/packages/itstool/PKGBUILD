# Maintainer: Yurei Linux project
pkgname=itstool
pkgver=2.0.7
pkgrel=1
pkgdesc="Translate XML metadata using Internationalization Tag Set rules"
arch=(any)
url="https://itstool.org/"
license=(GPL-3.0-or-later)
depends=(python libxml2)
source=("https://files.itstool.org/itstool/itstool-$pkgver.tar.bz2")
sha256sums=('6b9a7cd29a12bb95598f5750e8763cee78836a1a207f85b74d8b3275b27e87ca')
build() {
    cd itstool-$pkgver
    PYTHON=/usr/bin/python3 ./configure --prefix=/usr
    make
}
package() {
    cd itstool-$pkgver
    make DESTDIR="$pkgdir" install
}
