# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 2c, docs/INDEPENDENT.md). The source address and
# sum are the ones in independent/bootstrap/sources.lock; check-recipes.py
# keeps them the same.
pkgname=perl
pkgver=5.42.0
pkgrel=1
pkgdesc="A highly capable, feature-rich programming language"
arch=(x86_64)
url="https://www.perl.org/"
license=(GPL-1.0-or-later Artistic-1.0-Perl)
depends=(glibc gdbm libxcrypt zlib bzip2)
source=("https://www.cpan.org/src/5.0/perl-$pkgver.tar.xz")
sha256sums=('73cf6cc1ea2b2b1c110a18c14bbbc73a362073003893ffcedc26d22ebdbdd0c3')

build() {
    cd perl-$pkgver
    local v=${pkgver%.*}
    # the system's zlib and bzip2, not perl's own copies
    export BUILD_ZLIB=False BUILD_BZIP2=0
    sh Configure -des -D prefix=/usr -D vendorprefix=/usr \
        -D privlib=/usr/lib/perl5/$v/core_perl -D archlib=/usr/lib/perl5/$v/core_perl \
        -D sitelib=/usr/lib/perl5/$v/site_perl -D sitearch=/usr/lib/perl5/$v/site_perl \
        -D vendorlib=/usr/lib/perl5/$v/vendor_perl -D vendorarch=/usr/lib/perl5/$v/vendor_perl \
        -D man1dir=/usr/share/man/man1 -D man3dir=/usr/share/man/man3 \
        -D pager="/usr/bin/less -isR" -D useshrplib -D usethreads \
        -D optimize="$CFLAGS"
    make
}

package() {
    cd perl-$pkgver
    make DESTDIR="$pkgdir" install
}
