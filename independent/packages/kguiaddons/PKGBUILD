# Maintainer: Yūrei Linux project
# Yūrei's own recipe (stage 5, KDE Plasma; docs/INDEPENDENT.md). The source
# address and sum are the ones in independent/bootstrap/sources.lock
# (as kf6-kguiaddons); check-recipes.py keeps them the same.
pkgname=kguiaddons
_lockname=kf6-kguiaddons
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: GUI additions to Qt"
arch=(x86_64)
url="https://kde.org/"
license=(LGPL-2.0-or-later)
depends=(qt6-base qt6-wayland libx11)
makedepends=(extra-cmake-modules qt6-tools plasma-wayland-protocols wayland-protocols)
source=("https://download.kde.org/stable/frameworks/6.18/kguiaddons-$pkgver.tar.xz")
sha256sums=('2e2b872802d1b27b185512ffa9895906e7aa3438cbf137846ccff8216bbec466')

build() {
    cmake -S kguiaddons-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON -DWITH_X11=ON -DWITH_WAYLAND=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
