# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=knotifyconfig
_lockname=kf6-knotifyconfig
pkgver=6.18.0
pkgrel=1
pkgdesc="Desktop notification configuration"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 LGPL-2.0-only)
depends=(qt6-base kcompletion kconfig ki18n kio libcanberra)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/knotifyconfig-$pkgver.tar.xz")
sha256sums=('9a817fb4e1833be014370badc6bdbf464f1aa04e054016fc3bcafd053a19ada8')

build() {
    cmake -S knotifyconfig-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a knotifyconfig-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
