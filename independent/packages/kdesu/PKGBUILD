# Maintainer: Yurei Linux project
# Dependencies checked against the pinned upstream 6.18 CMake configuration.
pkgname=kdesu
_lockname=kf6-kdesu
pkgver=6.18.0
pkgrel=1
pkgdesc="KDE Frameworks: kdesu"
arch=(x86_64)
url="https://kde.org/"
license=(CC0-1.0 GPL-2.0-only LGPL-2.0-or-later LGPL-2.1-only LGPL-3.0-only)
depends=(qt6-base kconfig kcoreaddons ki18n kpty libx11)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/frameworks/6.18/kdesu-$pkgver.tar.xz")
sha256sums=('3203b047113cf08bca3981ede657e45b417a7cd0f2879bb4f9e901ad4e594616')

build() {
    cmake -S kdesu-$pkgver -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_DESIGNERPLUGIN=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a kdesu-$pkgver/LICENSES/. "$pkgdir/usr/share/licenses/$pkgname/"
}
