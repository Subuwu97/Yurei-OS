#!/usr/bin/env bash
# Called by the installer with the mount point of the freshly installed
# system. Installs the Yūrei packages shipped on the ISO into it.
set -euo pipefail

root=${1:?usage: yurei-install-target ROOT}
pkg_src=${YUREI_PKG_DIR:-/opt/yurei/packages}
signing_key=${YUREI_SIGNING_KEY_FILE:-/opt/yurei/yurei.asc}
repo_url=https://github.com/subuwu97/Y-rei-Linux/releases/download/repo
[[ -d $root/etc ]] || { echo "yurei-install-target: $root is not a system root" >&2; exit 1; }

shopt -s nullglob
pkgs=("$pkg_src"/*.pkg.tar.zst)
(( ${#pkgs[@]} )) || { echo "yurei-install-target: no packages in $pkg_src" >&2; exit 1; }

# Vulkan drivers for this machine's graphics. The gaming stack needs a
# (32-bit) Vulkan driver; left to choose on its own with --noconfirm, pacman
# takes the first provider listed, a legacy NVIDIA driver that conflicts
# with the one CachyOS installed.
gpu_drivers() {
    local vendors nvidia
    vendors=$(${YUREI_LSPCI:-lspci} -n 2>/dev/null | awk '$2 ~ /^03/ {print substr($3, 1, 4)}' | sort -u)
    if grep -qx 1002 <<< "$vendors"; then echo vulkan-radeon lib32-vulkan-radeon; fi
    if grep -qx 8086 <<< "$vendors"; then echo vulkan-intel lib32-vulkan-intel; fi
    if grep -qx 10de <<< "$vendors"; then
        # match the NVIDIA driver generation CachyOS's hardware detection installed
        nvidia=$(arch-chroot "$root" pacman -Qq 2>/dev/null | grep -E '^nvidia(-[0-9]+xx)?-utils$' || true)
        if [[ -n $nvidia ]]; then
            echo "lib32-${nvidia//$'\n'/ lib32-}"
        else
            echo vulkan-nouveau lib32-vulkan-nouveau
        fi
    fi
    if ! grep -qxE '1002|8086|10de' <<< "$vendors"; then
        echo vulkan-swrast lib32-vulkan-swrast  # VMs and anything else: CPU rendering
    fi
}
read -ra drivers <<< "$(gpu_drivers | tr '\n' ' ')"
if (( ${#drivers[@]} )); then
    arch-chroot "$root" pacman -S --noconfirm --needed "${drivers[@]}"
fi

install -d "$root/var/cache/pacman/pkg"
cp "${pkgs[@]}" "$root/var/cache/pacman/pkg/"
targets=()
for pkg in "${pkgs[@]}"; do
    targets+=("/var/cache/pacman/pkg/${pkg##*/}")
done
arch-chroot "$root" pacman -U --noconfirm --needed "${targets[@]}"

# Yūrei's login screen and boot animation. Neither is essential, so a
# failure is reported and the installation carries on; both can be retried
# or undone later with "yurei login-screen" and "yurei bootsplash".
if [[ -x $root/usr/lib/yurei/login-screen ]]; then
    arch-chroot "$root" /usr/lib/yurei/login-screen yurei ||
        echo "yurei-install-target: couldn't switch to the Yūrei login screen" >&2
fi
if [[ -x $root/usr/lib/yurei/bootsplash ]]; then
    arch-chroot "$root" /usr/lib/yurei/bootsplash on ||
        echo "yurei-install-target: couldn't enable the boot animation" >&2
fi

# CachyOS Hello greets every new user from /etc/skel; the accounts made by
# the installer already have a copy. Yūrei's desktop greets them instead
# (yurei-settings keeps it out of /etc/skel). Hello stays in the app menu.
rm -f "$root"/home/*/.config/autostart/cachyos-hello.desktop

# The Yūrei theme and colours for the accounts the installer created (new
# accounts get them from /etc/skel, set by yurei-settings' pacman hook)
if [[ -x $root/usr/lib/yurei/theme-defaults ]]; then
    for globals in "$root"/home/*/.config/kdeglobals; do
        arch-chroot "$root" /usr/lib/yurei/theme-defaults "${globals#"$root"}"
    done
fi

# Limine boot menu: CachyOS's installer names the entry "CachyOS" and sets
# its own wallpaper. limine-entry-tool finds the entry by its machine-id
# comment, so renaming it is safe. Plain ASCII: Limine's font has no "ū".
splash=$root/usr/share/yurei/boot-splash.png
for conf in "$root"/{boot,efi,boot/efi}/limine.conf; do
    [[ -f $conf ]] || continue
    sed -i 's|^/+CachyOS$|/+Yurei|' "$conf"
    old=$(sed -n 's|^wallpaper: boot():/||p' "$conf" | head -n1)
    if [[ -f $splash && -n $old && -f ${conf%/*}/$old ]]; then
        cp "$splash" "${conf%/*}/yurei-splash.png"
        sed -i 's|^wallpaper: boot():/.*|wallpaper: boot():/yurei-splash.png|' "$conf"
    fi
done

# GameMode needs its group to raise game priority
if arch-chroot "$root" getent group gamemode >/dev/null; then
    while IFS=: read -r name _ uid _; do
        if (( uid >= 1000 && uid < 60000 )); then
            arch-chroot "$root" usermod -aG gamemode "$name"
        fi
    done < "$root/etc/passwd"
fi

# Subscribe to the signed [yurei] repository for future updates
if [[ -f $signing_key ]] && ! grep -q '^\[yurei\]' "$root/etc/pacman.conf"; then
    fingerprint=$(gpg --batch --with-colons --show-keys "$signing_key" | awk -F: '/^fpr/ {print $10; exit}')
    [[ -n $fingerprint ]] || { echo "yurei-install-target: unreadable signing key" >&2; exit 1; }
    cp "$signing_key" "$root/tmp/yurei.asc"
    arch-chroot "$root" pacman-key --add /tmp/yurei.asc
    arch-chroot "$root" pacman-key --lsign-key "$fingerprint"
    rm -f "$root/tmp/yurei.asc"
    printf '\n[yurei]\nSigLevel = Required DatabaseRequired\nServer = %s\n' "$repo_url" >> "$root/etc/pacman.conf"
fi
