#!/usr/bin/env python3
"""Add Yūrei's install step and branding to the Calamares settings file.

CachyOS's launcher copies its settings into /etc/calamares/settings.conf just
before starting the installer; build.sh makes it run this script right after.
The step runs just before the target is unmounted, once everything else
(packages, bootloader, users) is in place. The branding
(/usr/share/calamares/branding/yurei) gives the installer Yūrei's look and
slides, and names the new system's boot entries.
"""

import sys

import yaml

INSTANCE = {"id": "yurei", "module": "shellprocess", "config": "shellprocess_yurei.conf"}
STEP = "shellprocess@yurei"
BRANDING = "yurei"


def patch(settings: dict) -> dict:
    settings["branding"] = BRANDING
    instances = settings.get("instances") or []
    if not any(i.get("id") == "yurei" and i.get("module") == "shellprocess" for i in instances):
        instances.append(dict(INSTANCE))
    settings["instances"] = instances

    for phase in settings.get("sequence") or []:
        steps = phase.get("exec") if isinstance(phase, dict) else None
        if steps is None:
            continue
        if STEP not in steps:
            at = steps.index("umount") if "umount" in steps else len(steps)
            steps.insert(at, STEP)
        return settings
    raise ValueError("Calamares settings have no exec phase")


def main(path: str) -> int:
    with open(path) as fh:
        settings = yaml.safe_load(fh)
    patch(settings)
    with open(path, "w") as fh:
        yaml.safe_dump(settings, fh, sort_keys=False, allow_unicode=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "/etc/calamares/settings.conf"))
